import { useEffect, useMemo, useRef, useState } from 'react';
import * as THREE from 'three';
import { fetchSlice } from '../services/zarrService';

type ColorMapName =
  | 'seismicTrace'
  | 'seismicTraceReverse'
  | 'grayscale'
  | 'blackWhiteBlack'
  | 'redBlackBlue'
  | 'brownWhiteBlue'
  | 'coolwarm';

type WaveDisplayMode = 'full' | 'peaks' | 'troughs';
type VolumeExtentMode = 'full' | 'local';
type VolumeQuality = 'preview' | 'balanced' | 'high' | 'diagnostic';
type VolumeBackgroundMode = 'off' | 'whole' | 'paged';

type VolumeCacheStatus = {
  loading: boolean;
  message: string;
};

type DirectionLoadStatus = {
  dim: 0 | 1 | 2;
  loading: boolean;
  loaded: number;
  total: number;
  status: 'idle' | 'loading' | 'paused' | 'loaded' | 'cancelled' | 'unloaded' | 'failed';
  message: string;
};

type VolumePagedRendererProps = {
  zarrPath: string;
  dim: 0 | 1 | 2;
  centerIndex: number;
  maxIndex: number;
  windowSize: number;
  step: number;
  extentMode: VolumeExtentMode;
  quality: VolumeQuality;
  backgroundMode: VolumeBackgroundMode;
  opacity: number;
  density: number;
  threshold: number;
  amplitudeGain: number;
  clipPercentile: number;
  colorMap: ColorMapName;
  waveDisplayMode: WaveDisplayMode;
  worldSize: { x: number; y: number; z: number };
  onCacheStatus?: (status: VolumeCacheStatus | null) => void;
  loadDirectionRequest?: number;
  pauseDirectionRequest?: number;
  unloadDirectionRequest?: number;
  onDirectionLoadStatus?: (status: DirectionLoadStatus | null) => void;
};

type LoadedSlice = {
  index: number;
  texture: THREE.DataTexture;
  active: boolean;
};

type TextureCacheEntry = {
  texture: THREE.DataTexture;
  lastUsed: number;
};

const MAX_TEXTURE_CACHE_ENTRIES = 1536;

function clamp01(value: number): number {
  return Math.max(0, Math.min(1, value));
}

function clamp255(value: number): number {
  return Math.max(0, Math.min(255, Math.round(value)));
}

function lerp(a: number, b: number, t: number): number {
  return a + (b - a) * t;
}

function mixRgb(
  a: [number, number, number],
  b: [number, number, number],
  t: number
): [number, number, number] {
  return [
    Math.round(lerp(a[0], b[0], t)),
    Math.round(lerp(a[1], b[1], t)),
    Math.round(lerp(a[2], b[2], t)),
  ];
}

function divergingColor(
  norm: number,
  negativeColor: [number, number, number],
  centerColor: [number, number, number],
  positiveColor: [number, number, number]
): [number, number, number] {
  if (norm >= 0) return mixRgb(centerColor, positiveColor, clamp01(norm));
  return mixRgb(centerColor, negativeColor, clamp01(-norm));
}

function colorForNorm(norm: number, colorMap: ColorMapName): [number, number, number] {
  switch (colorMap) {
    case 'grayscale': {
      const gray = Math.round(clamp01(0.5 + 0.5 * norm) * 255);
      return [gray, gray, gray];
    }
    case 'blackWhiteBlack': {
      const gray = Math.round((1 - clamp01(Math.abs(norm))) * 255);
      return [gray, gray, gray];
    }
    case 'seismicTraceReverse':
      return divergingColor(norm, [255, 0, 0], [255, 255, 255], [0, 0, 255]);
    case 'redBlackBlue':
      return divergingColor(norm, [0, 90, 255], [0, 0, 0], [255, 60, 60]);
    case 'brownWhiteBlue':
      return divergingColor(norm, [50, 90, 210], [255, 255, 255], [150, 95, 45]);
    case 'coolwarm':
      return divergingColor(norm, [59, 76, 192], [245, 245, 245], [180, 4, 38]);
    case 'seismicTrace':
    default:
      return divergingColor(norm, [0, 0, 255], [255, 255, 255], [255, 0, 0]);
  }
}

function estimateClipAbs(data: Float32Array, clipPercentile: number): number {
  const n = data.length;
  if (n === 0) return 1;

  const maxSamples = 50000;
  const stride = Math.max(1, Math.floor(n / maxSamples));
  const samples: number[] = [];

  for (let i = 0; i < n; i += stride) {
    const value = Math.abs(data[i]);
    if (Number.isFinite(value)) samples.push(value);
  }

  if (samples.length === 0) return 1;

  samples.sort((a, b) => a - b);

  const pct = Math.max(50, Math.min(99.99, clipPercentile));
  const idx = Math.min(
    samples.length - 1,
    Math.max(0, Math.floor((pct / 100) * (samples.length - 1)))
  );

  const clip = samples[idx];
  return clip > 0 && Number.isFinite(clip) ? clip : samples[samples.length - 1] || 1;
}

function getSourceIndex(
  texX: number,
  texY: number,
  axis0Count: number,
  axis1Count: number,
  flipAxis0: boolean,
  flipAxis1: boolean
): number {
  const sourceAxis0 = flipAxis0 ? axis0Count - 1 - texX : texX;
  const sourceAxis1 = flipAxis1 ? axis1Count - 1 - texY : texY;
  return sourceAxis0 * axis1Count + sourceAxis1;
}

function buildTextureFromSlice(
  data: Float32Array,
  shape: number[],
  dim: 0 | 1 | 2,
  amplitudeGain: number,
  clipPercentile: number,
  density: number,
  threshold: number,
  colorMap: ColorMapName,
  waveDisplayMode: WaveDisplayMode,
  opaqueMode: boolean
): THREE.DataTexture {
  const axis0Count = shape[0] ?? 1;
  const axis1Count = shape[1] ?? 1;
  const width = axis0Count;
  const height = axis1Count;
  const rgba = new Uint8Array(width * height * 4);

  const amplitudeClip = estimateClipAbs(data, clipPercentile);
  const safeClip = amplitudeClip > 0 ? amplitudeClip : 1;

  const flipAxis0 = dim === 0;
  const flipAxis1 = dim === 2;

  for (let texY = 0; texY < height; texY += 1) {
    for (let texX = 0; texX < width; texX += 1) {
      const src = getSourceIndex(texX, texY, axis0Count, axis1Count, flipAxis0, flipAxis1);
      let norm = Math.max(-1, Math.min(1, (data[src] / safeClip) * amplitudeGain));

      if (waveDisplayMode === 'peaks' && norm < 0) norm = 0;
      if (waveDisplayMode === 'troughs' && norm > 0) norm = 0;

      const absNorm = Math.abs(norm);
      const dst = (texY * width + texX) * 4;

      if (!opaqueMode && absNorm <= threshold) {
        rgba[dst] = 0;
        rgba[dst + 1] = 0;
        rgba[dst + 2] = 0;
        rgba[dst + 3] = 0;
        continue;
      }

      const rgb = colorForNorm(norm, colorMap);
      rgba[dst] = rgb[0];
      rgba[dst + 1] = rgb[1];
      rgba[dst + 2] = rgb[2];

      if (opaqueMode) {
        rgba[dst + 3] = 255;
      } else {
        const alphaNorm = threshold >= 1
          ? 0
          : (absNorm - threshold) / Math.max(0.0001, 1 - threshold);

        const visibleAlpha = alphaNorm <= 0
          ? 0
          : Math.max(0.08, Math.sqrt(clamp01(alphaNorm)) * density);

        rgba[dst + 3] = clamp255(255 * clamp01(visibleAlpha));
      }
    }
  }

  const texture = new THREE.DataTexture(
    rgba,
    width,
    height,
    THREE.RGBAFormat,
    THREE.UnsignedByteType
  );

  texture.needsUpdate = true;
  texture.minFilter = THREE.LinearFilter;
  texture.magFilter = THREE.LinearFilter;
  texture.generateMipmaps = false;
  texture.colorSpace = THREE.SRGBColorSpace;
  texture.flipY = false;

  return texture;
}

function targetSliceCountForQuality(quality: VolumeQuality): number {
  if (quality === 'preview') return 16;
  if (quality === 'balanced') return 80;
  if (quality === 'high') return 140;
  return 24;
}

function makeTextureCacheKey(
  displaySignature: string,
  index: number,
  opaqueMode: boolean
): string {
  return `${displaySignature}|index=${index}|opaque=${opaqueMode ? 1 : 0}`;
}

function getPlaneTransform(
  dim: 0 | 1 | 2,
  index: number,
  maxIndex: number,
  worldSize: { x: number; y: number; z: number }
): {
  position: [number, number, number];
  rotation: [number, number, number];
  planeSize: [number, number];
} {
  const t = maxIndex > 0 ? index / maxIndex - 0.5 : 0;

  if (dim === 0) {
    return {
      position: [t * worldSize.x, 0, 0],
      rotation: [0, Math.PI / 2, 0],
      planeSize: [worldSize.z, worldSize.y],
    };
  }

  if (dim === 1) {
    return {
      position: [0, 0, t * worldSize.z],
      rotation: [0, 0, 0],
      planeSize: [worldSize.x, worldSize.y],
    };
  }

  return {
    position: [0, t * worldSize.y, 0],
    rotation: [-Math.PI / 2, 0, 0],
    planeSize: [worldSize.x, worldSize.z],
  };
}

export default function VolumePagedRenderer({
  zarrPath,
  dim,
  centerIndex,
  maxIndex,
  windowSize,
  step,
  extentMode,
  quality,
  backgroundMode,
  opacity,
  density,
  threshold,
  amplitudeGain,
  clipPercentile,
  colorMap,
  waveDisplayMode,
  worldSize,
  onCacheStatus,
  loadDirectionRequest = 0,
  pauseDirectionRequest = 0,
  unloadDirectionRequest = 0,
  onDirectionLoadStatus,
}: VolumePagedRendererProps) {
  const [baseSlices, setBaseSlices] = useState<LoadedSlice[]>([]);
  const [activeSlice, setActiveSlice] = useState<LoadedSlice | null>(null);
  const textureCacheRef = useRef<Map<string, TextureCacheEntry>>(new Map());
  const textureRequestCacheRef = useRef<Map<string, Promise<THREE.DataTexture>>>(new Map());
  const requestVersionRef = useRef(0);
  const directionLoadVersionRef = useRef(0);
  const directionPauseRequestedRef = useRef(false);
  const textureCacheGenerationRef = useRef(0);

  const activeIndex = useMemo(() => {
    return Math.max(0, Math.min(maxIndex, centerIndex));
  }, [centerIndex, maxIndex]);

  const displaySignature = useMemo(() => {
    return [
      zarrPath,
      `dim=${dim}`,
      amplitudeGain.toFixed(4),
      clipPercentile.toFixed(3),
      density.toFixed(3),
      threshold.toFixed(4),
      colorMap,
      waveDisplayMode,
    ].join('|');
  }, [
    amplitudeGain,
    clipPercentile,
    colorMap,
    density,
    dim,
    threshold,
    waveDisplayMode,
    zarrPath,
  ]);

  const baseIndexes = useMemo(() => {
    if (backgroundMode === 'off') return [];

    const safeStep = Math.max(1, Math.floor(step || 1));

    // Active paging: use Step for page spacing and Local Thickness/windowSize
    // for the moving slab behind the active slice. The active slice itself
    // remains full-quality and is rendered separately.
    if (backgroundMode === 'paged') {
      if (windowSize === 0) return [];

      const thickness = Math.max(0, Math.floor(windowSize || 0));
      const start = Math.max(0, activeIndex - thickness);
      const indexes = new Set<number>();

      for (let index = activeIndex - safeStep; index >= start; index -= safeStep) {
        indexes.add(index);
      }

      return [...indexes].sort((a, b) => a - b);
    }

    if (extentMode === 'full') {
      // Whole-volume background: Step controls global page spacing.
      const indexes = new Set<number>();

      for (let index = 0; index <= maxIndex; index += safeStep) {
        indexes.add(index);
      }

      indexes.add(maxIndex);
      return [...indexes].sort((a, b) => a - b);
    }

    if (windowSize === 0) return [];

    const halfWindow = Math.floor(windowSize / 2);
    const start = Math.max(0, activeIndex - halfWindow);
    const end = Math.min(maxIndex, activeIndex + halfWindow);
    const indexes = new Set<number>();

    for (let index = start; index <= end; index += safeStep) {
      indexes.add(index);
    }

    return [...indexes].sort((a, b) => a - b);
  }, [activeIndex, backgroundMode, extentMode, maxIndex, quality, step, windowSize]);

  function trimTextureCache() {
    const cache = textureCacheRef.current;
    if (cache.size <= MAX_TEXTURE_CACHE_ENTRIES) return;

    const entries = [...cache.entries()].sort((a, b) => a[1].lastUsed - b[1].lastUsed);
    const removeCount = cache.size - MAX_TEXTURE_CACHE_ENTRIES;

    for (let i = 0; i < removeCount; i += 1) {
      const [key, entry] = entries[i];
      entry.texture.dispose();
      cache.delete(key);
    }
  }

  function getTextureFromCache(index: number, opaqueMode: boolean): THREE.DataTexture | null {
    const cacheKey = makeTextureCacheKey(displaySignature, index, opaqueMode);
    const cached = textureCacheRef.current.get(cacheKey);

    if (!cached) return null;

    cached.lastUsed = performance.now();
    return cached.texture;
  }

  async function getCachedTexture(
    index: number,
    opaqueMode: boolean
  ): Promise<THREE.DataTexture> {
    const cacheKey = makeTextureCacheKey(displaySignature, index, opaqueMode);

    const cached = getTextureFromCache(index, opaqueMode);
    if (cached) return cached;

    const pending = textureRequestCacheRef.current.get(cacheKey);
    if (pending) return pending;

    const requestGeneration = textureCacheGenerationRef.current;

    const request = fetchSlice(zarrPath, dim, index).then((result: any) => {
      const texture = buildTextureFromSlice(
        result.data,
        result.shape,
        dim,
        amplitudeGain,
        clipPercentile,
        density,
        threshold,
        colorMap,
        waveDisplayMode,
        opaqueMode
      );

      if (requestGeneration !== textureCacheGenerationRef.current) {
        // A direction unload/clear happened while this request was in flight.
        // Return the texture to the immediate caller if needed, but do not
        // reinsert stale data into the direction cache.
        return texture;
      }

      textureCacheRef.current.set(cacheKey, {
        texture,
        lastUsed: performance.now(),
      });

      trimTextureCache();

      return texture;
    });

    textureRequestCacheRef.current.set(cacheKey, request);

    try {
      return await request;
    } finally {
      textureRequestCacheRef.current.delete(cacheKey);
    }
  }

  function prefetchActiveNeighbors(index: number) {
    const neighbors = [index - 1, index + 1];

    for (const neighbor of neighbors) {
      if (neighbor < 0 || neighbor > maxIndex) continue;
      if (getTextureFromCache(neighbor, true)) continue;

      getCachedTexture(neighbor, true).catch((error) => {
        console.debug('Skipped active-neighbor prefetch', { dim, index: neighbor, error });
      });
    }
  }

  function directionLabel(nextDim: 0 | 1 | 2): string {
    if (nextDim === 0) return 'Inline';
    if (nextDim === 1) return 'Crossline';
    return 'Time';
  }

  function buildDirectionLoadOrder(center: number, total: number, pageStep: number): number[] {
    // Step-aware direction load order.
    // Step controls directional cache density.
    // The active slice and immediate neighbors are always included at full quality.
    const safeStep = Math.max(1, Math.floor(pageStep || 1));
    const order: number[] = [];
    const seen = new Set<number>();

    function add(index: number) {
      if (index < 0 || index >= total) return;
      if (seen.has(index)) return;
      seen.add(index);
      order.push(index);
    }

    add(center);

    // Keep the immediate active working area dense even when Step is large.
    for (let offset = 1; offset <= 3; offset += 1) {
      add(center - offset);
      add(center + offset);
    }

    // Then load the stepped direction cache outward from the current position.
    for (let offset = safeStep; offset < total + safeStep; offset += safeStep) {
      add(center - offset);
      add(center + offset);
    }

    // Include the endpoints so the selected direction has clear limits.
    add(0);
    add(total - 1);

    return order;
  }

  function getInitialDirectionConcurrency(nextDim: 0 | 1 | 2): number {
    return nextDim === 2 ? 2 : 4;
  }

  function getMaxDirectionConcurrency(nextDim: 0 | 1 | 2): number {
    const cpuHint = typeof navigator !== 'undefined' && navigator.hardwareConcurrency
      ? navigator.hardwareConcurrency
      : 4;

    if (nextDim === 2) return Math.max(2, Math.min(4, Math.floor(cpuHint / 2)));
    return Math.max(4, Math.min(8, cpuHint));
  }

  function getMinDirectionConcurrency(): number {
    return 1;
  }

  function browserYield(): Promise<void> {
    return new Promise((resolve) => window.setTimeout(resolve, 0));
  }

  useEffect(() => {
    let cancelled = false;
    const requestVersion = ++requestVersionRef.current;

    async function loadBaseSlices() {
      if (baseIndexes.length === 0) {
        setBaseSlices([]);
        return;
      }

      onCacheStatus?.({
        loading: true,
        message: 'Caching initial volume...',
      });

      const loaded: LoadedSlice[] = [];

      for (const index of baseIndexes) {
        try {
          const texture = await getCachedTexture(index, false);

          if (cancelled || requestVersion !== requestVersionRef.current) return;

          loaded.push({
            index,
            texture,
            active: false,
          });
        } catch (error) {
          console.error('Failed to load paged base slice', { dim, index, error });
        }
      }

      if (!cancelled && requestVersion === requestVersionRef.current) {
        setBaseSlices(loaded);
        onCacheStatus?.(null);
      }
    }

    loadBaseSlices();

    return () => {
      cancelled = true;
    };
  }, [baseIndexes, dim, displaySignature, zarrPath]);

  useEffect(() => {
    let cancelled = false;

    async function loadActiveSlice() {
      const opaqueMode = true;
      const cached = getTextureFromCache(activeIndex, opaqueMode);

      if (cached) {
        setActiveSlice({
          index: activeIndex,
          texture: cached,
          active: true,
        });
        return;
      }

      onCacheStatus?.({
        loading: true,
        message: 'Caching data...',
      });

      try {
        const texture = await getCachedTexture(activeIndex, opaqueMode);

        if (cancelled) return;

        setActiveSlice({
          index: activeIndex,
          texture,
          active: true,
        });

        onCacheStatus?.(null);

        window.setTimeout(() => {
          if (!cancelled) prefetchActiveNeighbors(activeIndex);
        }, 0);
      } catch (error) {
        console.error('Failed to load paged active slice', { dim, index: activeIndex, error });
        onCacheStatus?.(null);
      }
    }

    loadActiveSlice();

    return () => {
      cancelled = true;
    };
  }, [activeIndex, dim, displaySignature, zarrPath]);

  useEffect(() => {
    if (!loadDirectionRequest) return;

    let cancelled = false;
    const loadVersion = ++directionLoadVersionRef.current;
    const axisTotal = Math.max(0, maxIndex + 1);
    const label = directionLabel(dim);
    const loadOrder = buildDirectionLoadOrder(activeIndex, axisTotal, step);
    const total = loadOrder.length;

    async function loadDirection() {
      directionPauseRequestedRef.current = false;

      if (total <= 0) {
        onDirectionLoadStatus?.({
          dim,
          loading: false,
          loaded: 0,
          total: 0,
          status: 'failed',
          message: `${label} has no slices to load`,
        });
        return;
      }

      let loaded = 0;

      onDirectionLoadStatus?.({
        dim,
        loading: true,
        loaded,
        total,
        status: 'loading',
        message: `Loading ${label} — ${loaded} / ${total}`,
      });

      let cursor = 0;
      let concurrency = getInitialDirectionConcurrency(dim);
      const maxConcurrency = getMaxDirectionConcurrency(dim);
      const minConcurrency = getMinDirectionConcurrency();

      while (cursor < loadOrder.length) {
        if (cancelled || loadVersion !== directionLoadVersionRef.current) {
          const paused = directionPauseRequestedRef.current;

          onDirectionLoadStatus?.({
            dim,
            loading: false,
            loaded,
            total,
            status: paused ? 'paused' : 'cancelled',
            message: paused
              ? `${label} loading paused — ${loaded} / ${total}`
              : `${label} loading cancelled — ${loaded} / ${total}`,
          });
          return;
        }

        const batch = loadOrder.slice(cursor, cursor + concurrency);
        cursor += batch.length;

        const batchStarted = performance.now();

        await Promise.all(batch.map(async (index) => {
          try {
            await getCachedTexture(index, true);
            loaded += 1;
          } catch (error) {
            console.error('Failed while loading direction cache', { dim, index, error });
          }
        }));

        const batchMs = performance.now() - batchStarted;
        const avgSliceMs = batch.length > 0 ? batchMs / batch.length : batchMs;

        if (avgSliceMs < 90 && concurrency < maxConcurrency) {
          concurrency += 1;
        } else if (avgSliceMs > 260 && concurrency > minConcurrency) {
          concurrency -= 1;
        }

        onDirectionLoadStatus?.({
          dim,
          loading: true,
          loaded,
          total,
          status: 'loading',
          message: `Loading ${label} — ${loaded} / ${total} · concurrent x${concurrency}`,
        });

        await browserYield();
      }

      if (!cancelled && loadVersion === directionLoadVersionRef.current) {
        onDirectionLoadStatus?.({
          dim,
          loading: false,
          loaded,
          total,
          status: 'loaded',
          message: `${label} loaded — step ${Math.max(1, Math.floor(step || 1))}, ${loaded} / ${total}`,
        });
      }
    }

    loadDirection();

    return () => {
      cancelled = true;
    };
  }, [loadDirectionRequest]);

  useEffect(() => {
    if (!pauseDirectionRequest) return;

    directionPauseRequestedRef.current = true;
    directionLoadVersionRef.current += 1;

    const label = directionLabel(dim);

    onDirectionLoadStatus?.({
      dim,
      loading: false,
      loaded: 0,
      total: Math.max(0, maxIndex + 1),
      status: 'paused',
      message: `${label} loading paused`,
    });
  }, [pauseDirectionRequest]);

  useEffect(() => {
    if (!unloadDirectionRequest) return;

    directionPauseRequestedRef.current = false;
    directionLoadVersionRef.current += 1;
    textureCacheGenerationRef.current += 1;

    const label = directionLabel(dim);
    const prefix = displaySignature + '|';
    let removed = 0;

    for (const [key, entry] of textureCacheRef.current.entries()) {
      if (!key.startsWith(prefix)) continue;

      entry.texture.dispose();
      textureCacheRef.current.delete(key);
      removed += 1;
    }

    for (const key of textureRequestCacheRef.current.keys()) {
      if (key.startsWith(prefix)) textureRequestCacheRef.current.delete(key);
    }

    onDirectionLoadStatus?.({
      dim,
      loading: false,
      loaded: 0,
      total: Math.max(0, maxIndex + 1),
      status: 'unloaded',
      message: `${label} unloaded — removed ${removed} textures`,
    });
  }, [unloadDirectionRequest]);

  useEffect(() => {
    return () => {
      textureCacheRef.current.forEach((entry) => entry.texture.dispose());
      textureCacheRef.current.clear();
      textureRequestCacheRef.current.clear();
      onCacheStatus?.(null);
    };
  }, [onCacheStatus]);

  const visibleBaseSlices =
    backgroundMode === 'off'
      ? []
      : backgroundMode === 'whole'
        ? baseSlices
        : baseSlices.filter((slice) => slice.index < activeIndex);

  const renderedSlices = activeSlice
    ? [
        ...visibleBaseSlices.filter((slice) => slice.index !== activeSlice.index),
        activeSlice,
      ]
    : visibleBaseSlices;

  return (
    <group>
      {renderedSlices.map((slice) => {
        const pagedMode = extentMode === 'full' && backgroundMode === 'paged';

        // Paged mode filters the background, but does not pin the active pane.
        // The active pane must move through the cube at its true position so
        // amplitude changes are visible while scrolling.
        const displayIndex = slice.index;
        const displayMaxIndex = maxIndex;

        const transform = getPlaneTransform(dim, displayIndex, displayMaxIndex, worldSize);
        const opaqueSlice = slice.active;
return (
          <mesh
            key={`${dim}-${slice.index}-${slice.active ? 'active' : 'base'}-${backgroundMode}`}
            position={transform.position}
            rotation={transform.rotation}
            renderOrder={slice.active ? 100000 + slice.index : slice.index}
            raycast={() => null}
          >
            <planeGeometry args={transform.planeSize} />
            <meshBasicMaterial
              map={slice.texture}
              transparent={!opaqueSlice}
              opacity={opaqueSlice ? 1 : opacity}
              depthWrite={opaqueSlice}
              depthTest={true}
              side={THREE.DoubleSide}
              toneMapped={false}
              polygonOffset={opaqueSlice}
              polygonOffsetFactor={opaqueSlice ? -2 : 0}
              polygonOffsetUnits={opaqueSlice ? -2 : 0}
            />
          </mesh>
        );
      })}
    </group>
  );
}
