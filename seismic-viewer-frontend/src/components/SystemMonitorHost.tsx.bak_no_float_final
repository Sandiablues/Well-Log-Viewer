import React, { useCallback, useEffect, useMemo, useRef, useState } from 'react'

type MonitorPayload = {
  backend?: {
    status?: string
    timestamp?: string
    backend_root?: string
    data_dir?: string
    zarr_dir?: string
    zarr_tmp_dir?: string
    zarr_tmp_size_bytes?: number
    zarr_tmp_file_count?: number
  }
  conversion_jobs?: Array<{
    job_id?: string
    filename?: string
    status?: string
    message?: string
    progress?: number | null
    input_path?: string
    output_path?: string
    temp_output_path?: string
    temp_exists?: boolean
    temp_size_bytes?: number
    temp_file_count?: number
    seconds_since_last_write?: number | null
    health?: string
    health_reason?: string
    error?: string | null
  }>
  repositories?: Array<{
    repository_id?: string
    name?: string
    status?: string
    last_scanned_at?: string
    package_count?: number
    line_count?: number
    segy_file_count?: number
    document_count?: number
  }>
  warnings?: Array<{
    level?: string
    type?: string
    message?: string
    volume_id?: string
    filename?: string
    sidecar?: string
    sample_interval_us?: number
    count?: number
  }>
}

type JobSnapshot = {
  temp_size_bytes?: number
  temp_file_count?: number
}

type JobDelta = {
  sizeDelta?: number
  fileDelta?: number
}

const STORAGE_KEY = 'seismicViewer.launchSystemMonitorOnStartup'

function formatBytes(value?: number): string {
  if (value === undefined || value === null || Number.isNaN(value)) return '—'
  const units = ['B', 'KB', 'MB', 'GB', 'TB']
  let n = value
  let i = 0
  while (Math.abs(n) >= 1024 && i < units.length - 1) {
    n = n / 1024
    i += 1
  }
  const sign = value > 0 ? '+' : ''
  return `${sign}${n.toFixed(i === 0 ? 0 : 1)} ${units[i]}`
}

function formatPlainBytes(value?: number): string {
  if (value === undefined || value === null || Number.isNaN(value)) return '—'
  const units = ['B', 'KB', 'MB', 'GB', 'TB']
  let n = value
  let i = 0
  while (n >= 1024 && i < units.length - 1) {
    n = n / 1024
    i += 1
  }
  return `${n.toFixed(i === 0 ? 0 : 1)} ${units[i]}`
}

function badgeColor(value?: string): React.CSSProperties {
  const base: React.CSSProperties = {
    display: 'inline-block',
    padding: '2px 8px',
    borderRadius: 999,
    fontSize: 12,
    fontWeight: 700,
    border: '1px solid rgba(255,255,255,0.16)',
  }

  switch ((value || '').toLowerCase()) {
    case 'online':
    case 'running':
    case 'available':
      return { ...base, background: '#14532d', color: '#dcfce7' }
    case 'possibly_stalled':
    case 'warning':
    case 'queued':
      return { ...base, background: '#713f12', color: '#fef3c7' }
    case 'failed':
    case 'error':
      return { ...base, background: '#7f1d1d', color: '#fee2e2' }
    case 'complete':
    case 'completed':
    case 'converted':
    case 'ready':
      return { ...base, background: '#1e3a8a', color: '#dbeafe' }
    default:
      return { ...base, background: '#334155', color: '#e2e8f0' }
  }
}

function row(label: string, value: React.ReactNode) {
  return (
    <div style={{ display: 'grid', gridTemplateColumns: '155px 1fr', gap: 10, marginBottom: 5 }}>
      <div style={{ color: '#94a3b8' }}>{label}</div>
      <div style={{ color: '#e5e7eb', wordBreak: 'break-word' }}>{value || '—'}</div>
    </div>
  )
}

function isActiveJob(job: NonNullable<MonitorPayload['conversion_jobs']>[number]) {
  const status = (job.status || '').toLowerCase()
  const health = (job.health || '').toLowerCase()
  return ['queued', 'running', 'converting', 'processing'].includes(status) ||
    ['running', 'possibly_stalled'].includes(health)
}

export default function SystemMonitorHost() {
  const [open, setOpen] = useState(false)
  const [autoOpen, setAutoOpen] = useState(false)
  const [payload, setPayload] = useState<MonitorPayload | null>(null)
  const [error, setError] = useState<string | null>(null)
  const [lastRefresh, setLastRefresh] = useState<string>('—')
  const [jobDeltas, setJobDeltas] = useState<Record<string, JobDelta>>({})
  const previousJobsRef = useRef<Record<string, JobSnapshot>>({})

  useEffect(() => {
    const enabled = localStorage.getItem(STORAGE_KEY) === 'true'
    setAutoOpen(enabled)
    if (enabled) setOpen(true)
  }, [])

  useEffect(() => {
    const openHandler = () => setOpen(true)
    const closeHandler = () => setOpen(false)
    const toggleHandler = () => setOpen((value) => !value)

    window.addEventListener('seismicViewer.openSystemMonitor', openHandler)
    window.addEventListener('seismicViewer.closeSystemMonitor', closeHandler)
    window.addEventListener('seismicViewer.toggleSystemMonitor', toggleHandler)

    return () => {
      window.removeEventListener('seismicViewer.openSystemMonitor', openHandler)
      window.removeEventListener('seismicViewer.closeSystemMonitor', closeHandler)
      window.removeEventListener('seismicViewer.toggleSystemMonitor', toggleHandler)
    }
  }, [])

  const refresh = useCallback(async () => {
    try {
      const response = await fetch('/api/system/monitor', { cache: 'no-store' })
      if (!response.ok) throw new Error(`HTTP ${response.status}`)

      const data = (await response.json()) as MonitorPayload
      const nextSnapshots: Record<string, JobSnapshot> = {}
      const nextDeltas: Record<string, JobDelta> = {}

      for (const job of data.conversion_jobs || []) {
        if (!job.job_id) continue

        const previous = previousJobsRef.current[job.job_id]
        const current = {
          temp_size_bytes: job.temp_size_bytes,
          temp_file_count: job.temp_file_count,
        }

        nextSnapshots[job.job_id] = current

        if (previous) {
          nextDeltas[job.job_id] = {
            sizeDelta:
              previous.temp_size_bytes !== undefined && current.temp_size_bytes !== undefined
                ? current.temp_size_bytes - previous.temp_size_bytes
                : undefined,
            fileDelta:
              previous.temp_file_count !== undefined && current.temp_file_count !== undefined
                ? current.temp_file_count - previous.temp_file_count
                : undefined,
          }
        }
      }

      previousJobsRef.current = {
        ...previousJobsRef.current,
        ...nextSnapshots,
      }

      setJobDeltas(nextDeltas)
      setPayload(data)
      setError(null)
      setLastRefresh(new Date().toLocaleTimeString())
    } catch (err) {
      setError(err instanceof Error ? err.message : String(err))
      setLastRefresh(new Date().toLocaleTimeString())
    }
  }, [])

  useEffect(() => {
    refresh()
    const timer = window.setInterval(refresh, open ? 5000 : 10000)
    return () => window.clearInterval(timer)
  }, [open, refresh])

  const activeJobs = useMemo(() => {
    return (payload?.conversion_jobs || []).filter(isActiveJob)
  }, [payload])

  const orderedJobs = useMemo(() => {
    return [...(payload?.conversion_jobs || [])].sort((a, b) => {
      const aActive = isActiveJob(a) ? 1 : 0
      const bActive = isActiveJob(b) ? 1 : 0
      return bActive - aActive
    })
  }, [payload])

  const changeAutoOpen = (checked: boolean) => {
    setAutoOpen(checked)
    localStorage.setItem(STORAGE_KEY, checked ? 'true' : 'false')
  }

  const copyDiagnostics = async () => {
    await navigator.clipboard.writeText(JSON.stringify(payload || { error }, null, 2))
  }

  return (
    <>
      <button
        type="button"
        onClick={() => setOpen(true)}
        style={{
          position: 'fixed',
          right: 18,
          bottom: 18,
          zIndex: 9998,
          background: activeJobs.length > 0 ? '#14532d' : '#111827',
          color: '#f9fafb',
          border: '1px solid #374151',
          borderRadius: 12,
          padding: '9px 12px',
          fontSize: 13,
          fontWeight: 700,
          boxShadow: '0 10px 30px rgba(0,0,0,0.35)',
          cursor: 'pointer',
        }}
      >
        System{activeJobs.length > 0 ? ` · ${activeJobs.length} active` : ''}
      </button>

      {open && (
        <div
          style={{
            position: 'fixed',
            inset: 0,
            zIndex: 9999,
            background: 'rgba(0,0,0,0.48)',
            display: 'flex',
            justifyContent: 'flex-end',
          }}
        >
          <div
            style={{
              width: 'min(920px, 94vw)',
              height: '100vh',
              overflow: 'auto',
              background: '#0f172a',
              color: '#e5e7eb',
              boxShadow: '-20px 0 50px rgba(0,0,0,0.45)',
              padding: 22,
              fontFamily: 'Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif',
            }}
          >
            <div style={{ display: 'flex', justifyContent: 'space-between', gap: 12, alignItems: 'center', marginBottom: 18 }}>
              <div>
                <div style={{ fontSize: 22, fontWeight: 800 }}>System Monitor</div>
                <div style={{ color: '#94a3b8', fontSize: 13 }}>
                  Live backend health, conversion jobs, repositories, and managed-data warnings
                </div>
              </div>

              <div style={{ display: 'flex', gap: 8 }}>
                <button onClick={refresh} style={buttonStyle}>Refresh</button>
                <button onClick={copyDiagnostics} style={buttonStyle}>Copy Diagnostics</button>
                <button onClick={() => setOpen(false)} style={buttonStyle}>Close</button>
              </div>
            </div>

            <div style={cardStyle}>
              <div style={titleStyle}>Settings</div>
              <label style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                <input
                  type="checkbox"
                  checked={autoOpen}
                  onChange={(event) => changeAutoOpen(event.target.checked)}
                />
                <span>Launch System Monitor on application startup</span>
              </label>
            </div>

            <div style={cardStyle}>
              <div style={titleStyle}>Backend Health</div>
              {row('Status', <span style={badgeColor(error ? 'error' : payload?.backend?.status)}>{error ? 'error' : payload?.backend?.status || 'unknown'}</span>)}
              {row('Last refresh', lastRefresh)}
              {row('Backend timestamp', payload?.backend?.timestamp)}
              {row('Data dir', payload?.backend?.data_dir)}
              {row('Zarr tmp size', formatPlainBytes(payload?.backend?.zarr_tmp_size_bytes))}
              {row('Zarr tmp files', payload?.backend?.zarr_tmp_file_count)}
              {error && row('Error', <span style={{ color: '#fecaca' }}>{error}</span>)}
            </div>

            <div style={cardStyle}>
              <div style={titleStyle}>Active / Recent Conversions</div>
              {orderedJobs.length === 0 && <div style={mutedStyle}>No conversion jobs found.</div>}

              {orderedJobs.slice(0, 12).map((job) => {
                const delta = job.job_id ? jobDeltas[job.job_id] : undefined
                const active = isActiveJob(job)

                return (
                  <div
                    key={job.job_id || job.filename}
                    style={{
                      ...subCardStyle,
                      borderColor: active ? '#22c55e' : '#334155',
                    }}
                  >
                    <div style={{ display: 'flex', justifyContent: 'space-between', gap: 12 }}>
                      <div style={{ fontWeight: 800, wordBreak: 'break-word' }}>{job.filename || 'Unnamed job'}</div>
                      <span style={badgeColor(job.health || job.status)}>{job.health || job.status || 'unknown'}</span>
                    </div>
                    <div style={{ marginTop: 8 }}>
                      {row('Job ID', job.job_id)}
                      {row('Status', job.status)}
                      {row('Message', job.message)}
                      {row('Health reason', job.health_reason)}
                      {row('Temp exists', String(Boolean(job.temp_exists)))}
                      {row('Temp size', formatPlainBytes(job.temp_size_bytes))}
                      {row('Temp files', job.temp_file_count)}
                      {row('Since last write', job.seconds_since_last_write === undefined || job.seconds_since_last_write === null ? '—' : `${job.seconds_since_last_write}s`)}
                      {row('Growth since poll', `${delta?.sizeDelta === undefined ? '—' : formatBytes(delta.sizeDelta)} / ${delta?.fileDelta === undefined ? '—' : `${delta.fileDelta >= 0 ? '+' : ''}${delta.fileDelta} files`}`)}
                      {row('Input', job.input_path)}
                      {row('Output', job.output_path)}
                      {row('Temp output', job.temp_output_path)}
                      {job.error && row('Error', <span style={{ color: '#fecaca' }}>{job.error}</span>)}
                    </div>
                  </div>
                )
              })}
            </div>

            <div style={cardStyle}>
              <div style={titleStyle}>Repository Scans</div>
              {(payload?.repositories || []).length === 0 && <div style={mutedStyle}>No registered repositories found.</div>}

              {(payload?.repositories || []).map((repo) => (
                <div key={repo.repository_id || repo.name} style={subCardStyle}>
                  <div style={{ display: 'flex', justifyContent: 'space-between', gap: 12 }}>
                    <div style={{ fontWeight: 800 }}>{repo.name || repo.repository_id || 'Unnamed repository'}</div>
                    <span style={badgeColor(repo.status)}>{repo.status || 'unknown'}</span>
                  </div>
                  <div style={{ marginTop: 8 }}>
                    {row('Repository ID', repo.repository_id)}
                    {row('Last scanned', repo.last_scanned_at)}
                    {row('Packages', repo.package_count)}
                    {row('Lines', repo.line_count)}
                    {row('SEG-Y files', repo.segy_file_count)}
                    {row('Documents', repo.document_count)}
                  </div>
                </div>
              ))}
            </div>

            <div style={cardStyle}>
              <div style={titleStyle}>Managed Data Warnings</div>
              {(payload?.warnings || []).length === 0 && <div style={mutedStyle}>No warnings reported.</div>}

              {(payload?.warnings || []).slice(0, 80).map((warning, index) => (
                <div key={`${warning.type}-${warning.volume_id}-${index}`} style={subCardStyle}>
                  <div style={{ display: 'flex', justifyContent: 'space-between', gap: 12 }}>
                    <div style={{ fontWeight: 800 }}>{warning.type || 'warning'}</div>
                    <span style={badgeColor(warning.level)}>{warning.level || 'warning'}</span>
                  </div>
                  <div style={{ marginTop: 5 }}>{warning.message || '—'}</div>
                  <div style={{ color: '#94a3b8', fontSize: 12, marginTop: 5, wordBreak: 'break-word' }}>
                    {warning.filename ? `File: ${warning.filename}` : ''}
                    {warning.volume_id ? ` · Volume: ${warning.volume_id}` : ''}
                    {warning.sidecar ? ` · Sidecar: ${warning.sidecar}` : ''}
                    {warning.sample_interval_us !== undefined ? ` · sample_interval_us: ${warning.sample_interval_us}` : ''}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}
    </>
  )
}

const cardStyle: React.CSSProperties = {
  border: '1px solid #334155',
  background: '#1e293b',
  borderRadius: 16,
  padding: 14,
  marginBottom: 14,
}

const subCardStyle: React.CSSProperties = {
  border: '1px solid #334155',
  borderRadius: 12,
  padding: 12,
  marginTop: 10,
  background: '#111827',
}

const titleStyle: React.CSSProperties = {
  fontSize: 15,
  fontWeight: 800,
  marginBottom: 10,
}

const mutedStyle: React.CSSProperties = {
  color: '#94a3b8',
}

const buttonStyle: React.CSSProperties = {
  background: '#1f2937',
  color: '#f9fafb',
  border: '1px solid #475569',
  borderRadius: 10,
  padding: '7px 10px',
  fontSize: 13,
  fontWeight: 700,
  cursor: 'pointer',
}
