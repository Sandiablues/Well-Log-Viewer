import React, { useEffect, useRef, useState } from 'react';
import { fetchSection2D, fetchSlice, getZarrMetadata } from '../services/zarrService';
import { formatAxisLabel, getVerticalAxis } from '../utils/axisInfo';


function format2DTickValue(value: number, discrete = false): string {
  if (!Number.isFinite(value)) return '—';

  if (discrete) {
    return String(Math.round(value));
  }

  if (Math.abs(value) >= 1000) {
    return Number.isInteger(value) ? value.toFixed(0) : value.toFixed(1);
  }

  if (Number.isInteger(value)) {
    return value.toFixed(0);
  }

  return Number(value.toFixed(3)).toString();
}

function get2DShape(lineInfo: any): number[] {
  const shape = lineInfo?.metadata?.shape || lineInfo?.metadata?.zarr?.shape || lineInfo?.shape;
  return Array.isArray(shape) ? shape : [];
}

function get2DAxisDisplayInfo(lineInfo: any) {
  const metadata = lineInfo?.metadata || {};
  const shape = get2DShape(lineInfo);

  const traceCount =
    Number(metadata.trace_count || metadata.zarr?.trace_count || lineInfo?.trace_count || shape?.[0] || 0);

  const sampleCount =
    Number(metadata.sample_count || metadata.zarr?.sample_count || lineInfo?.sample_count || shape?.[1] || 0);

  const verticalAxis = getVerticalAxis(lineInfo);

  const verticalMin =
    verticalAxis?.min !== null && verticalAxis?.min !== undefined
      ? Number(verticalAxis.min)
      : 0;

  const verticalMax =
    verticalAxis?.max !== null && verticalAxis?.max !== undefined
      ? Number(verticalAxis.max)
      : Math.max(0, sampleCount - 1);

  const verticalLabel = verticalAxis ? formatAxisLabel(verticalAxis) : 'Sample';
  const verticalUnit = verticalAxis?.unit && !['index', 'number', 'sample'].includes(String(verticalAxis.unit))
    ? String(verticalAxis.unit)
    : '';

  return {
    horizontal: {
      label: 'Trace',
      min: 0,
      max: Math.max(0, traceCount - 1),
      discrete: true,
    },
    vertical: {
      label: verticalUnit ? `${verticalLabel} (${verticalUnit})` : verticalLabel,
      min: Number.isFinite(verticalMin) ? verticalMin : 0,
      max: Number.isFinite(verticalMax) ? verticalMax : Math.max(0, sampleCount - 1),
      discrete: !verticalAxis,
    },
  };
}

interface Seismic2DViewerProps {
  zarrPath: string;
  dim: number;
  lineInfo?: any;
  surveyName?: string;
  defaultShowLineInfo?: boolean;
  controlledShowLineInfo?: boolean;
  showLineInfoControl?: boolean;
}

type DisplayMode = 'color' | 'gray' | 'wiggle' | 'wiggle_positive' | 'wiggle_negative';
type ProcessingMode = 'raw' | 'demean' | 'trace_rms' | 'agc';

function formatLineInfoValue(value: any): string {
  if (value === null || value === undefined || value === '') return '—';
  if (Array.isArray(value)) return value.join(' × ');
  return String(value);
}

function LineInfoRow({ label, value }: { label: string; value: any }) {
  return (
    <div
      style={{
        display: 'grid',
        gridTemplateColumns: '92px 1fr',
        gap: '8px',
        fontSize: '12px',
        padding: '5px 0',
        borderBottom: '1px solid #303030',
      }}
    >
      <div style={{ opacity: 0.65 }}>{label}</div>
      <div style={{ wordBreak: 'break-word' }}>{formatLineInfoValue(value)}</div>
    </div>
  );
}


export const Seismic2DViewer: React.FC<Seismic2DViewerProps> = ({ zarrPath, dim, lineInfo, surveyName, defaultShowLineInfo = true, controlledShowLineInfo, showLineInfoControl = true }) => {
  const canvasRef = useRef<HTMLCanvasElement>(null);
  const viewportRef = useRef<HTMLDivElement>(null);

  const [index, setIndex] = useState(0);
  const [metadata, setMetadata] = useState<any>(null);
  const [gain, setGain] = useState(1.0);
  const [clipPercentile, setClipPercentile] = useState(99.0);
  const [processingMode, setProcessingMode] = useState<ProcessingMode>('demean');
  const [displayMode, setDisplayMode] = useState<DisplayMode>('gray');
  const [fitToWidth, setFitToWidth] = useState(true);
  const [reversePolarity, setReversePolarity] = useState(false);
  const [reverseDirection, setReverseDirection] = useState(false);
  const [xScale, setXScale] = useState(1.0);
  const [yScale, setYScale] = useState(1.0);
  const [wiggleScale, setWiggleScale] = useState(1.0);
  const [traceDecimation, setTraceDecimation] = useState('auto');
  const [showTimelines, setShowTimelines] = useState(true);
  const [showAxisLabels, setShowAxisLabels] = useState(true);
  const [menuCollapsed, setMenuCollapsed] = useState(false);
  const [timelineIntervalMs, setTimelineIntervalMs] = useState(100);
  const [sectionInfo, setSectionInfo] = useState<any>(null);
  const [cursorInfo, setCursorInfo] = useState<any>(null);
  const [showLineInfoDrawer, setShowLineInfoDrawer] = useState(defaultShowLineInfo);
  const effectiveShowLineInfoDrawer = controlledShowLineInfo ?? showLineInfoDrawer;
  const [zoomDrag, setZoomDrag] = useState<any>(null);
  const [boxZoomEnabled, setBoxZoomEnabled] = useState(false);

  useEffect(() => {
    getZarrMetadata(zarrPath).then(setMetadata);
  }, [zarrPath]);

  useEffect(() => {
    async function renderSection() {
      if (!canvasRef.current || !metadata) return;

      const isTrue2DLine = metadata.shape?.length === 2;

      const slice = isTrue2DLine
        ? await fetchSection2D(zarrPath, 1600, 900, clipPercentile, processingMode)
        : await fetchSlice(zarrPath, dim, index);

      setSectionInfo({
        sourceShape: slice.source_shape || slice.shape,
        previewShape: slice.shape,
        traceStride: slice.trace_stride || 1,
        sampleStride: slice.sample_stride || 1,
        clipAbs: slice.clip_abs,
        clipPercentile: slice.clip_percentile,
        processingMode: slice.processing_mode,
        preview: slice.preview,
      });

      const data = Array.isArray(slice.data) ? slice.data : Array.from(slice.data as any);
      const [traceCountRaw, sampleCountRaw] = slice.shape;

      const traceCount = isTrue2DLine ? traceCountRaw : sampleCountRaw;
      const sampleCount = isTrue2DLine ? sampleCountRaw : traceCountRaw;

      const canvas = canvasRef.current;
      canvas.width = traceCount;
      canvas.height = sampleCount;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const clipAbs = Math.max(Number(slice.clip_abs) || 1, 1e-12);
      const polarity = reversePolarity ? -1 : 1;

      const getRawValue = (trace: number, sample: number) => {
        if (isTrue2DLine) {
          const actualTrace = reverseDirection ? traceCount - 1 - trace : trace;
          return Number(data[actualTrace * sampleCount + sample]) || 0;
        }

        return Number(data[sample * traceCount + trace]) || 0;
      };

      const getNormValue = (trace: number, sample: number) => {
        const val = getRawValue(trace, sample) * polarity * gain / clipAbs;
        return Math.max(-1, Math.min(1, val));
      };

      const drawTimelines = () => {
        if (!showTimelines) return;

        const sampleRateMs = Number(metadata.sample_rate || metadata.sample_interval_ms || 0);
        const sampleStride = Number(slice.sample_stride || 1);
        if (!sampleRateMs || !timelineIntervalMs) return;

        const previewSampleIntervalMs = sampleRateMs * sampleStride;
        const lineStep = Math.max(1, Math.round(timelineIntervalMs / previewSampleIntervalMs));

        ctx.save();
        ctx.strokeStyle = 'rgba(0,0,0,0.22)';
        ctx.lineWidth = 1;

        for (let y = lineStep; y < sampleCount; y += lineStep) {
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(traceCount, y);
          ctx.stroke();
        }

        ctx.restore();
      };

      const renderRaster = () => {
        const imageData = ctx.createImageData(traceCount, sampleCount);

        for (let y = 0; y < sampleCount; y++) {
          for (let x = 0; x < traceCount; x++) {
            const pixelIndex = y * traceCount + x;
            const norm = getNormValue(x, y);

            if (displayMode === 'gray') {
              const gray = Math.max(0, Math.min(255, 128 + norm * 128));
              imageData.data[pixelIndex * 4] = gray;
              imageData.data[pixelIndex * 4 + 1] = gray;
              imageData.data[pixelIndex * 4 + 2] = gray;
            } else {
              if (norm < 0) {
                const intensity = 1 + norm;
                imageData.data[pixelIndex * 4] = intensity * 255;
                imageData.data[pixelIndex * 4 + 1] = intensity * 255;
                imageData.data[pixelIndex * 4 + 2] = 255;
              } else {
                const intensity = 1 - norm;
                imageData.data[pixelIndex * 4] = 255;
                imageData.data[pixelIndex * 4 + 1] = intensity * 255;
                imageData.data[pixelIndex * 4 + 2] = intensity * 255;
              }
            }

            imageData.data[pixelIndex * 4 + 3] = 255;
          }
        }

        ctx.putImageData(imageData, 0, 0);
        drawTimelines();
      };

      const renderWiggle = () => {
        ctx.save();
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, traceCount, sampleCount);

        drawTimelines();

        const decimation =
          traceDecimation === 'auto'
            ? Math.max(1, Math.ceil(traceCount / 450))
            : Math.max(1, parseInt(traceDecimation, 10) || 1);

        const traceSpacing = decimation;
        const ampScale = Math.max(0.1, wiggleScale) * traceSpacing * 0.75;

        for (let trace = 0; trace < traceCount; trace += decimation) {
          const baseline = trace;

          if (displayMode === 'wiggle_positive' || displayMode === 'wiggle_negative') {
            ctx.beginPath();
            ctx.moveTo(baseline, 0);

            for (let sample = 0; sample < sampleCount; sample++) {
              const norm = getNormValue(trace, sample);
              const useFill =
                displayMode === 'wiggle_positive'
                  ? norm > 0
                  : norm < 0;

              const x = useFill ? baseline + norm * ampScale : baseline;
              ctx.lineTo(x, sample);
            }

            ctx.lineTo(baseline, sampleCount - 1);
            ctx.closePath();

            ctx.fillStyle =
              displayMode === 'wiggle_positive'
                ? 'rgba(0,0,0,0.28)'
                : 'rgba(80,80,80,0.22)';
            ctx.fill();
          }

          ctx.beginPath();

          for (let sample = 0; sample < sampleCount; sample++) {
            const norm = getNormValue(trace, sample);
            const x = baseline + norm * ampScale;

            if (sample === 0) {
              ctx.moveTo(x, sample);
            } else {
              ctx.lineTo(x, sample);
            }
          }

          ctx.strokeStyle = '#000000';
          ctx.lineWidth = 0.8;
          ctx.stroke();
        }

        ctx.restore();
      };

      if (displayMode === 'color' || displayMode === 'gray') {
        renderRaster();
      } else {
        renderWiggle();
      }
    }

    renderSection().catch((err) => {
      console.error('Failed to render 2D section', err);
    });
  }, [
    zarrPath,
    dim,
    index,
    metadata,
    gain,
    clipPercentile,
    processingMode,
    displayMode,
    reversePolarity,
    reverseDirection,
    wiggleScale,
    traceDecimation,
    showTimelines,
    timelineIntervalMs,
  ]);

  if (!metadata) return <div>Loading...</div>;

  const maxIndex = metadata.shape?.length === 2 ? 0 : metadata.shape[dim] - 1;

  const getCanvasPoint = (event: React.MouseEvent<HTMLCanvasElement>) => {
    const canvas = canvasRef.current;
    if (!canvas) return null;

    const rect = canvas.getBoundingClientRect();

    return {
      canvas,
      rect,
      xCss: event.clientX - rect.left,
      yCss: event.clientY - rect.top,
      xCanvas: Math.max(0, Math.min(canvas.width, ((event.clientX - rect.left) / rect.width) * canvas.width)),
      yCanvas: Math.max(0, Math.min(canvas.height, ((event.clientY - rect.top) / rect.height) * canvas.height)),
    };
  };

  const handleCanvasMouseMove = (event: React.MouseEvent<HTMLCanvasElement>) => {
    const point = getCanvasPoint(event);
    if (!point || !metadata?.shape) return;

    if (zoomDrag?.active) {
      setZoomDrag({
        ...zoomDrag,
        currentXCss: point.xCss,
        currentYCss: point.yCss,
        currentXCanvas: point.xCanvas,
        currentYCanvas: point.yCanvas,
      });
    }

    const canvas = point.canvas;
    const previewTrace = Math.max(0, Math.min(canvas.width - 1, Math.floor(point.xCanvas)));
    const previewSample = Math.max(0, Math.min(canvas.height - 1, Math.floor(point.yCanvas)));

    const traceStride = Number(sectionInfo?.traceStride || 1);
    const sampleStride = Number(sectionInfo?.sampleStride || 1);

    const sourceTrace = reverseDirection
      ? Math.max(0, (sectionInfo?.sourceShape?.[0] || metadata.shape?.[0] || 0) - 1 - previewTrace * traceStride)
      : previewTrace * traceStride;

    const sourceSample = previewSample * sampleStride;
    const sampleRate = Number(metadata.sample_rate || metadata.sample_interval_ms || 0);
    const timeMs = sampleRate ? sourceSample * sampleRate : null;

    setCursorInfo({
      trace: sourceTrace,
      sample: sourceSample,
      timeMs,
    });
  };

  const handleCanvasMouseDown = (event: React.MouseEvent<HTMLCanvasElement>) => {
    if (!boxZoomEnabled) return;
    if (event.button !== 0) return;

    const point = getCanvasPoint(event);
    if (!point) return;

    setZoomDrag({
      active: true,
      startXCss: point.xCss,
      startYCss: point.yCss,
      currentXCss: point.xCss,
      currentYCss: point.yCss,
      startXCanvas: point.xCanvas,
      startYCanvas: point.yCanvas,
      currentXCanvas: point.xCanvas,
      currentYCanvas: point.yCanvas,
    });
  };

  const handleCanvasMouseUp = () => {
    if (!boxZoomEnabled) return;
    if (!zoomDrag?.active) return;

    const viewport = viewportRef.current;
    const canvas = canvasRef.current;

    if (!viewport || !canvas) {
      setZoomDrag(null);
      return;
    }

    const x1 = Math.min(zoomDrag.startXCanvas, zoomDrag.currentXCanvas);
    const x2 = Math.max(zoomDrag.startXCanvas, zoomDrag.currentXCanvas);
    const y1 = Math.min(zoomDrag.startYCanvas, zoomDrag.currentYCanvas);
    const y2 = Math.max(zoomDrag.startYCanvas, zoomDrag.currentYCanvas);

    const boxWidth = x2 - x1;
    const boxHeight = y2 - y1;

    setZoomDrag(null);

    if (boxWidth < 10 || boxHeight < 10) return;

    const targetXScale = Math.max(1, Math.min(20, canvas.width / boxWidth));
    const targetYScale = Math.max(1, Math.min(20, canvas.height / boxHeight));

    setFitToWidth(false);
    setXScale(targetXScale);
    setYScale(targetYScale);

    window.setTimeout(() => {
      const scaledLeft = x1 * targetXScale;
      const scaledTop = y1 * targetYScale;

      viewport.scrollLeft = Math.max(0, scaledLeft - viewport.clientWidth * 0.08);
      viewport.scrollTop = Math.max(0, scaledTop - viewport.clientHeight * 0.08);
    }, 0);
  };

  const handleCanvasDoubleClick = () => {
    setXScale(1.0);
    setYScale(1.0);
    setFitToWidth(true);
    setZoomDrag(null);
    setZoomDrag(null);

    const viewport = viewportRef.current;
    if (viewport) {
      viewport.scrollLeft = 0;
      viewport.scrollTop = 0;
    }
  };

  const resetDisplay = () => {
    setGain(1.0);
    setClipPercentile(99.0);
    setProcessingMode('demean');
    setDisplayMode('gray');
    setReversePolarity(false);
    setReverseDirection(false);
    setXScale(1.0);
    setYScale(1.0);
    setWiggleScale(1.0);
    setTraceDecimation('auto');
    setShowTimelines(true);
    setTimelineIntervalMs(100);
    setFitToWidth(true);
    setZoomDrag(null);
  };

  const panelStyle: React.CSSProperties = {
    width: '270px',
    minWidth: '270px',
    padding: '12px',
    borderRight: '1px solid #333',
    background: '#1b1b1b',
    overflowY: 'auto',
    boxSizing: 'border-box',
  };

  const sectionStyle: React.CSSProperties = {
    marginBottom: '16px',
    paddingBottom: '12px',
    borderBottom: '1px solid #303030',
  };

  const sectionTitleStyle: React.CSSProperties = {
    fontSize: '12px',
    textTransform: 'uppercase',
    letterSpacing: '0.06em',
    opacity: 0.65,
    marginBottom: '8px',
  };

  const rowStyle: React.CSSProperties = {
    display: 'grid',
    gridTemplateColumns: '88px 1fr',
    alignItems: 'center',
    gap: '8px',
    marginBottom: '8px',
    fontSize: '13px',
  };

  const selectStyle: React.CSSProperties = {
    background: '#2b2b2b',
    color: 'white',
    border: '1px solid #555',
    borderRadius: '4px',
    padding: '4px 6px',
    width: '100%',
  };

  const buttonStyle: React.CSSProperties = {
    background: '#333',
    color: 'white',
    border: '1px solid #555',
    borderRadius: '4px',
    padding: '6px 8px',
    cursor: 'pointer',
    width: '100%',
  };

  const checkboxRowStyle: React.CSSProperties = {
    display: 'flex',
    alignItems: 'center',
    gap: '6px',
    marginBottom: '8px',
    fontSize: '13px',
  };

  const valueStyle: React.CSSProperties = {
    fontSize: '12px',
    opacity: 0.75,
    textAlign: 'right',
  };

  return (
    <div
      style={{
        display: 'flex',
        height: '100%',
        background: '#222',
        color: 'white',
        boxSizing: 'border-box',
        minHeight: 0,
      }}
    >
      <aside
        style={{
          ...panelStyle,
          width: menuCollapsed ? 36 : panelStyle.width,
          minWidth: menuCollapsed ? 36 : panelStyle.minWidth,
          padding: menuCollapsed ? '8px 4px' : panelStyle.padding,
          overflow: menuCollapsed ? 'hidden' : panelStyle.overflow,
        }}
      >
        <button
          type="button"
          onClick={() => setMenuCollapsed((value) => !value)}
          title={menuCollapsed ? 'Expand 2D controls' : 'Collapse 2D controls'}
          style={{
            width: '100%',
            marginBottom: menuCollapsed ? 0 : 10,
            background: '#2f2f2f',
            color: '#fff',
            border: '1px solid #555',
            borderRadius: 4,
            padding: '4px 0',
            cursor: 'pointer',
            fontSize: 13,
            lineHeight: 1,
          }}
        >
          {menuCollapsed ? '›' : '‹'}
        </button>

        {!menuCollapsed && (
          <>
        <div style={sectionStyle}>
          <div style={sectionTitleStyle}>Display</div>

          <div style={rowStyle}>
            <label>Mode</label>
            <select value={displayMode} onChange={(e) => setDisplayMode(e.target.value as DisplayMode)} style={selectStyle}>
              <option value="gray">Gray</option>
              <option value="color">Color</option>
              <option value="wiggle">Wiggle</option>
              <option value="wiggle_positive">Wiggle + positive fill</option>
              <option value="wiggle_negative">Wiggle + negative fill</option>
            </select>
          </div>

          <div style={rowStyle}>
            <label>Process</label>
            <select value={processingMode} onChange={(e) => setProcessingMode(e.target.value as ProcessingMode)} style={selectStyle}>
              <option value="raw">Raw</option>
              <option value="demean">Demean</option>
              <option value="trace_rms">Trace RMS</option>
              <option value="agc">AGC Preview</option>
            </select>
          </div>

          <div style={rowStyle}>
            <label>Clip</label>
            <select value={clipPercentile} onChange={(e) => setClipPercentile(parseFloat(e.target.value))} style={selectStyle}>
              <option value={95}>P95</option>
              <option value={98}>P98</option>
              <option value={99}>P99</option>
              <option value={99.5}>P99.5</option>
              <option value={99.9}>P99.9</option>
            </select>
          </div>

          <div style={rowStyle}>
            <label>Gain</label>
            <div>
              <input type="range" min={0.1} max={10} step={0.1} value={gain} onChange={(e) => setGain(parseFloat(e.target.value))} style={{ width: '100%' }} />
              <div style={valueStyle}>{gain.toFixed(1)}×</div>
            </div>
          </div>
        </div>

        <div style={sectionStyle}>
          <div style={sectionTitleStyle}>Wiggle</div>

          <div style={rowStyle}>
            <label>Scale</label>
            <div>
              <input type="range" min={0.2} max={5} step={0.1} value={wiggleScale} onChange={(e) => setWiggleScale(parseFloat(e.target.value))} style={{ width: '100%' }} />
              <div style={valueStyle}>{wiggleScale.toFixed(1)}×</div>
            </div>
          </div>

          <div style={rowStyle}>
            <label>Trace step</label>
            <select value={traceDecimation} onChange={(e) => setTraceDecimation(e.target.value)} style={selectStyle}>
              <option value="auto">Auto</option>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="4">4</option>
              <option value="8">8</option>
              <option value="16">16</option>
            </select>
          </div>
        </div>

        <div style={sectionStyle}>
          <div style={sectionTitleStyle}>View</div>

          <label style={checkboxRowStyle}>
            <input type="checkbox" checked={fitToWidth} onChange={(e) => setFitToWidth(e.target.checked)} />
            Fit width
          </label>
          {showLineInfoControl && (
            <label style={checkboxRowStyle}>
              <input type="checkbox" checked={showLineInfoDrawer} onChange={(e) => setShowLineInfoDrawer(e.target.checked)} />
              Show line info
            </label>
          )}


          <label style={checkboxRowStyle}>
            <input type="checkbox" checked={showTimelines} onChange={(e) => setShowTimelines(e.target.checked)} />
            Timelines
          </label>

          <label style={checkboxRowStyle}>
            <input type="checkbox" checked={showAxisLabels} onChange={(e) => setShowAxisLabels(e.target.checked)} />
            Axis labels
          </label>

          <div style={rowStyle}>
            <label>TL ms</label>
            <select value={timelineIntervalMs} onChange={(e) => setTimelineIntervalMs(parseInt(e.target.value, 10))} style={selectStyle}>
              <option value={50}>50</option>
              <option value={100}>100</option>
              <option value={250}>250</option>
              <option value={500}>500</option>
            </select>
          </div>

          <label style={checkboxRowStyle}>
            <input type="checkbox" checked={reverseDirection} onChange={(e) => setReverseDirection(e.target.checked)} />
            Reverse direction
          </label>

          <label style={checkboxRowStyle}>
            <input type="checkbox" checked={reversePolarity} onChange={(e) => setReversePolarity(e.target.checked)} />
            Reverse polarity
          </label>
        </div>

        <div style={sectionStyle}>
          <div style={sectionTitleStyle}>Zoom</div>

          <div style={rowStyle}>
            <label>Horizontal</label>
            <div>
              <input type="range" min={0.5} max={5} step={0.1} value={xScale} onChange={(e) => setXScale(parseFloat(e.target.value))} style={{ width: '100%' }} />
              <div style={valueStyle}>{xScale.toFixed(1)}×</div>
            </div>
          </div>

          <div style={rowStyle}>
            <label>Vertical</label>
            <div>
              <input type="range" min={0.5} max={5} step={0.1} value={yScale} onChange={(e) => setYScale(parseFloat(e.target.value))} style={{ width: '100%' }} />
              <div style={valueStyle}>{yScale.toFixed(1)}×</div>
            </div>
          </div>

          <label style={checkboxRowStyle}>
            <input
              type="checkbox"
              checked={boxZoomEnabled}
              onChange={(e) => {
                setBoxZoomEnabled(e.target.checked);
                setZoomDrag(null);
              }}
            />
            Box zoom
          </label>

          <button onClick={resetDisplay} style={buttonStyle}>
            Reset display
          </button>
        </div>
          </>
        )}
      </aside>

      <section
        style={{
          flex: 1,
          minWidth: 0,
          minHeight: 0,
          display: 'flex',
          flexDirection: 'column',
          background: '#202020',
        }}
      >
        <div
          style={{
            padding: '8px 12px',
            borderBottom: '1px solid #333',
            fontSize: '12px',
            opacity: 0.85,
            whiteSpace: 'nowrap',
            overflow: 'hidden',
            textOverflow: 'ellipsis',
          }}
          title={[
            `2D section: ${metadata.shape?.join(' × ')}`,
            sectionInfo?.previewShape ? `preview ${sectionInfo.previewShape.join(' × ')}` : '',
            sectionInfo?.traceStride ? `stride ${sectionInfo.traceStride} × ${sectionInfo.sampleStride}` : '',
            sectionInfo?.clipAbs ? `clip P${sectionInfo.clipPercentile ?? clipPercentile}: ${Number(sectionInfo.clipAbs).toFixed(1)}` : '',
            sectionInfo?.processingMode || '',
          ].filter(Boolean).join(' | ')}
        >
          2D section: {metadata.shape?.join(' × ')}
          {sectionInfo?.previewShape ? ` | preview ${sectionInfo.previewShape.join(' × ')}` : ''}
          {sectionInfo?.traceStride ? ` | stride ${sectionInfo.traceStride} × ${sectionInfo.sampleStride}` : ''}
          {sectionInfo?.clipAbs ? ` | clip P${sectionInfo.clipPercentile ?? clipPercentile}: ${Number(sectionInfo.clipAbs).toFixed(1)}` : ''}
          {sectionInfo?.processingMode ? ` | ${sectionInfo.processingMode}` : ''}
          {cursorInfo ? ` | trace ${Math.round(cursorInfo.trace)}, sample ${Math.round(cursorInfo.sample)}${cursorInfo.timeMs != null ? `, ${cursorInfo.timeMs.toFixed(1)} ms` : ''}` : ''} {boxZoomEnabled ? ' | drag box to zoom, double-click reset' : ''}
        </div>

        {metadata.shape?.length !== 2 && (
          <div style={{ padding: '8px 12px', borderBottom: '1px solid #333' }}>
            <label>Slice Index: </label>
            <input
              type="range"
              min={0}
              max={maxIndex}
              value={index}
              onChange={(e) => setIndex(parseInt(e.target.value, 10))}
            />
            <span> {index}</span>
          </div>
        )}

        <div
          ref={viewportRef}
          style={{
            flex: 1,
            overflow: 'auto',
            background: '#000',
            minHeight: 0,
            padding: '12px',
            boxSizing: 'border-box',
          }}
        >
          <div
            style={{
              position: 'relative',
              width: fitToWidth ? `${100 * xScale}%` : `${(canvasRef.current?.width || 100) * xScale}px`,
              height: `${(canvasRef.current?.height || 100) * yScale}px`,
              margin: '0 auto',
            }}
          >
            <canvas
              ref={canvasRef}
              onMouseDown={handleCanvasMouseDown}
              onMouseMove={handleCanvasMouseMove}
              onMouseUp={handleCanvasMouseUp}
              onDoubleClick={handleCanvasDoubleClick}
              onMouseLeave={() => {
                setCursorInfo(null);
                if (zoomDrag?.active) setZoomDrag(null);
              }}
              style={{
                imageRendering: 'pixelated',
                width: '100%',
                height: '100%',
                display: 'block',
                background: '#fff',
                cursor: boxZoomEnabled ? 'crosshair' : 'default',
              }}
            />

            {showAxisLabels && (() => {
              const axisInfo = get2DAxisDisplayInfo(lineInfo);

              const tickStyle: React.CSSProperties = {
                position: 'absolute',
                color: '#f5f7fb',
                background: 'rgba(12, 16, 24, 0.42)',
                border: '1px solid rgba(255,255,255,0.10)',
                borderRadius: 4,
                padding: '1px 4px',
                fontSize: 9,
                fontWeight: 600,
                pointerEvents: 'none',
                zIndex: 12,
                opacity: 0.75,
                whiteSpace: 'nowrap',
              };

              const titleStyle: React.CSSProperties = {
                position: 'absolute',
                color: '#f5f7fb',
                background: 'rgba(12, 16, 24, 0.34)',
                border: '1px solid rgba(255,255,255,0.08)',
                borderRadius: 4,
                padding: '1px 5px',
                fontSize: 9,
                fontWeight: 700,
                pointerEvents: 'none',
                zIndex: 12,
                opacity: 0.70,
                whiteSpace: 'nowrap',
              };

              return (
                <>
                  {/* Horizontal trace labels: just below the seismic image */}
                  <div
                    style={{
                      ...tickStyle,
                      left: 0,
                      bottom: -18,
                    }}
                  >
                    {format2DTickValue(axisInfo.horizontal.min, true)}
                  </div>

                  <div
                    style={{
                      ...tickStyle,
                      right: 0,
                      bottom: -18,
                    }}
                  >
                    {format2DTickValue(axisInfo.horizontal.max, true)}
                  </div>

                  <div
                    style={{
                      ...titleStyle,
                      left: '50%',
                      bottom: -34,
                      transform: 'translateX(-50%)',
                    }}
                  >
                    {axisInfo.horizontal.label}
                  </div>

                  {/* Vertical labels: just left of the seismic image */}
                  <div
                    style={{
                      ...tickStyle,
                      left: -48,
                      top: 0,
                    }}
                  >
                    {format2DTickValue(axisInfo.vertical.min, axisInfo.vertical.discrete)}
                  </div>

                  <div
                    style={{
                      ...tickStyle,
                      left: -48,
                      bottom: 0,
                    }}
                  >
                    {format2DTickValue(axisInfo.vertical.max, axisInfo.vertical.discrete)}
                  </div>

                  <div
                    style={{
                      ...titleStyle,
                      left: -72,
                      top: '50%',
                      transform: 'translateY(-50%) rotate(-90deg)',
                      transformOrigin: 'center center',
                    }}
                  >
                    {axisInfo.vertical.label}
                  </div>
                </>
              );
            })()}

            {boxZoomEnabled && zoomDrag?.active && (
              <div
                style={{
                  position: 'absolute',
                  pointerEvents: 'none',
                  left: `${Math.min(zoomDrag.startXCss, zoomDrag.currentXCss)}px`,
                  top: `${Math.min(zoomDrag.startYCss, zoomDrag.currentYCss)}px`,
                  width: `${Math.abs(zoomDrag.currentXCss - zoomDrag.startXCss)}px`,
                  height: `${Math.abs(zoomDrag.currentYCss - zoomDrag.startYCss)}px`,
                  border: '2px solid #4aa3ff',
                  background: 'rgba(74, 163, 255, 0.15)',
                  boxSizing: 'border-box',
                }}
              />
            )}
          </div>
        </div>
      </section>

      {effectiveShowLineInfoDrawer && (
        <aside
          style={{
            width: '300px',
            minWidth: '300px',
            borderLeft: '1px solid #333',
            background: '#1b1b1b',
            overflowY: 'auto',
            boxSizing: 'border-box',

          }}
        >
          <div
            style={{
              position: 'sticky',
              top: 0,
              zIndex: 2,
              background: '#1b1b1b',
              borderBottom: '1px solid #333',
              padding: '10px 12px',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
              gap: '8px',
            }}
          >
            <strong style={{ fontSize: '13px' }}>Line Info</strong>
            <button
              onClick={() => setShowLineInfoDrawer(false)}
              style={{
                background: '#333',
                color: 'white',
                border: '1px solid #555',
                borderRadius: '4px',
                padding: '4px 7px',
                cursor: 'pointer',
                fontSize: '12px',
              }}
            >
              Collapse
            </button>
          </div>

          <div style={{ padding: '12px' }}>
          <div style={{ marginBottom: '14px' }}>
            <div
              style={{
                fontSize: '12px',
                textTransform: 'uppercase',
                letterSpacing: '0.06em',
                opacity: 0.6,
                marginBottom: '6px',
              }}
            >
              Line Info
            </div>

            <LineInfoRow label="Survey" value={surveyName} />
            <LineInfoRow label="Line" value={lineInfo?.line_name || lineInfo?.display_name || lineInfo?.filename || lineInfo?.id} />
            <LineInfoRow label="File" value={lineInfo?.filename} />
            <LineInfoRow label="Rel Path" value={lineInfo?.source_relative_path || lineInfo?.metadata?.source_relative_path} />
            <LineInfoRow label="Shape" value={lineInfo?.shape || metadata?.shape} />
            <LineInfoRow label="Traces" value={lineInfo?.trace_count || lineInfo?.shape?.[0] || metadata?.shape?.[0]} />
            <LineInfoRow label="Samples" value={lineInfo?.sample_count || lineInfo?.shape?.[1] || metadata?.shape?.[1]} />
            <LineInfoRow label="Sample Rate" value={
              lineInfo?.sample_rate
                ? `${lineInfo.sample_rate} ms`
                : metadata?.sample_rate
                  ? `${metadata.sample_rate} ms`
                  : metadata?.sample_interval_ms
                    ? `${metadata.sample_interval_ms} ms`
                    : null
            } />
            <LineInfoRow label="Axis" value={lineInfo?.axis_order || metadata?.zarr?.axis_order || ['trace', 'sample']} />
            <LineInfoRow label="Line ID" value={lineInfo?.line_id || lineInfo?.id} />
            <LineInfoRow label="Zarr" value={lineInfo?.zarr_url || zarrPath} />
          </div>

          <div style={{ marginBottom: '14px' }}>
            <div
              style={{
                fontSize: '12px',
                textTransform: 'uppercase',
                letterSpacing: '0.06em',
                opacity: 0.6,
                marginBottom: '6px',
              }}
            >
              Current Display
            </div>

            <LineInfoRow label="Display" value={displayMode} />
            <LineInfoRow label="Process" value={processingMode} />
            <LineInfoRow label="Clip" value={sectionInfo?.clipPercentile ? `P${sectionInfo.clipPercentile}` : `P${clipPercentile}`} />
            <LineInfoRow label="Clip Abs" value={sectionInfo?.clipAbs ? Number(sectionInfo.clipAbs).toFixed(1) : null} />
            <LineInfoRow label="Preview" value={sectionInfo?.previewShape} />
            <LineInfoRow label="Stride" value={sectionInfo?.traceStride ? `${sectionInfo.traceStride} × ${sectionInfo.sampleStride}` : null} />
          </div>

          <div style={{ fontSize: '12px', opacity: 0.65, lineHeight: 1.4 }}>
            Full SEG-Y headers and supporting-document links remain in the main Info tab.
          </div>
          </div>
        </aside>)}
    </div>
  );
};
