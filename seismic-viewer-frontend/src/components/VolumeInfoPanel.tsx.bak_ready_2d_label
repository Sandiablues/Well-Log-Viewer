import { useEffect, useState } from 'react';
import type { Volume } from '../services/zarrService';
import { getVolumeInfo } from '../services/zarrService';

interface VolumeInfoPanelProps {
  volume: Volume | null;
}

function getDisplayName(volume: Volume): string {
  return volume.display_name || volume.filename || volume.id;
}

function getShape(volume: Volume): string {
  const shape = volume.metadata?.shape || volume.metadata?.zarr?.shape;
  return Array.isArray(shape) ? shape.join(' × ') : 'Unknown';
}

function getGeometrySource(volume: Volume): string {
  return volume.metadata?.geometry_source || volume.metadata?.zarr?.geometry_source || 'Unknown';
}

function formatValue(value: unknown): string {
  if (value === null || value === undefined || value === '') return '—';
  if (Array.isArray(value)) return value.join(' × ');
  return String(value);
}

export function VolumeInfoPanel({ volume }: VolumeInfoPanelProps) {
  const [infoData, setInfoData] = useState<any>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    if (!volume?.id) {
      setInfoData(null);
      setError(null);
      setLoading(false);
      return;
    }

    let cancelled = false;

    async function loadInfo() {
      setLoading(true);
      setError(null);

      try {
        const data = await getVolumeInfo(volume.id);
        if (!cancelled) {
          setInfoData(data);
        }
      } catch (err) {
        console.error('Failed to load selected volume info', err);
        if (!cancelled) {
          setError('Failed to load selected volume information.');
        }
      } finally {
        if (!cancelled) {
          setLoading(false);
        }
      }
    }

    loadInfo();

    return () => {
      cancelled = true;
    };
  }, [volume?.id]);

  if (!volume) {
    return (
      <div className="volume-info-panel empty-info">
        <h2>Volume Information</h2>
        <p>No volume selected. Load a volume from the Data Manager or select one from the viewer dropdown.</p>
      </div>
    );
  }

  const metadata = volume.metadata || {};
  const zarrMetadata = metadata.zarr || {};
  const viewerMetadata = infoData?.viewer_metadata;

  return (
    <div className="volume-info-panel">
      <div className="volume-info-header">
        <div>
          <h2>{getDisplayName(volume)}</h2>
          <p>{volume.filename}</p>
        </div>
      </div>

      {loading && <div className="info-loading">Loading volume information...</div>}
      {error && <div className="info-error">{error}</div>}

      {!loading && !error && (
        <div className="volume-info-content">
          <section>
            <h3>Overview</h3>
            <div className="info-grid">
              <div><strong>Volume ID</strong><span>{volume.id}</span></div>
              <div><strong>Shape</strong><span>{getShape(volume)}</span></div>
              <div><strong>Zarr URL</strong><span>{volume.zarr_url}</span></div>
              <div><strong>Data Type</strong><span>{formatValue(zarrMetadata.dtype)}</span></div>
              <div><strong>Chunks</strong><span>{formatValue(zarrMetadata.chunks)}</span></div>
              <div><strong>Ready Status</strong><span>{metadata.is_3d === false ? 'Not 3D' : 'Ready 3D'}</span></div>
            </div>
          </section>

          <section>
            <h3>Geometry</h3>
            <div className="info-grid">
              <div><strong>Geometry Source</strong><span>{getGeometrySource(volume)}</span></div>
              <div><strong>Inline Range</strong><span>{formatValue(metadata.inline_range || (metadata.inlines ? [metadata.inlines[0], metadata.inlines[metadata.inlines.length - 1]] : null))}</span></div>
              <div><strong>Crossline Range</strong><span>{formatValue(metadata.crossline_range || (metadata.crosslines ? [metadata.crosslines[0], metadata.crosslines[metadata.crosslines.length - 1]] : null))}</span></div>
              <div><strong>Sample Range</strong><span>{formatValue(metadata.sample_range_ms || (metadata.samples ? [metadata.samples[0], metadata.samples[metadata.samples.length - 1]] : null))}</span></div>
              <div><strong>Sample Rate</strong><span>{formatValue(metadata.sample_rate || metadata.sample_interval_ms)} ms</span></div>
              <div><strong>Axis Order</strong><span>{formatValue(zarrMetadata.axis_order || metadata.axis_order)}</span></div>
            </div>
          </section>

          <section>
            <h3>Conversion Statistics</h3>
            <div className="info-grid">
              <div><strong>Input Trace Count</strong><span>{formatValue(metadata.trace_count || zarrMetadata.trace_count)}</span></div>
              <div><strong>Written Traces</strong><span>{formatValue(zarrMetadata.written_traces)}</span></div>
              <div><strong>Skipped Traces</strong><span>{formatValue(zarrMetadata.skipped_traces)}</span></div>
              <div><strong>Expected Trace Positions</strong><span>{formatValue(zarrMetadata.expected_trace_positions)}</span></div>
              <div><strong>Missing Trace Positions</strong><span>{formatValue(zarrMetadata.missing_trace_positions)}</span></div>
              <div><strong>Missing Trace Fill</strong><span>{formatValue(zarrMetadata.missing_trace_fill)}</span></div>
              <div><strong>Batch Size</strong><span>{formatValue(zarrMetadata.batch_size_inlines)} inlines</span></div>
              <div><strong>Batch Writes</strong><span>{formatValue(zarrMetadata.batch_writes)}</span></div>
              <div><strong>Converter Version</strong><span>{formatValue(viewerMetadata?.source?.converter_version)}</span></div>
            </div>
          </section>

          <section>
            <h3>SEG-Y Textual Header</h3>
            <pre className="text-header">{infoData?.text_header || 'Textual header not available for this volume.'}</pre>
          </section>

          <section>
            <h3>Binary Header</h3>
            <pre className="json-block">{infoData?.binary_header ? JSON.stringify(infoData.binary_header, null, 2) : 'Binary header not available for this volume.'}</pre>
          </section>

          <section>
            <h3>Trace Header Summary</h3>
            <pre className="json-block">{infoData?.trace_header_summary ? JSON.stringify(infoData.trace_header_summary, null, 2) : 'Trace header summary not available for this volume.'}</pre>
          </section>

          <section>
            <h3>Supporting Documents</h3>
            <div className="supporting-documents-placeholder">
              <p>No supporting documents linked yet.</p>
              <p>
                Reserved for external project documents such as acquisition reports,
                processing reports, interpretation notes, QC summaries, survey documentation,
                or related PDFs stored outside this application.
              </p>
            </div>
          </section>
        </div>
      )}
    </div>
  );
}
