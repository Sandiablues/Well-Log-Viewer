import { Trash2, Eye, EyeOff, Edit3, Database } from 'lucide-react';
import type { Volume } from '../services/zarrService';
import { deleteVolume, updateVolume } from '../services/zarrService';

interface DataManagerProps {
  volumes: Volume[];
  selectedVolume: Volume | null;
  onSelectVolume: (volume: Volume) => void;
  onRefreshVolumes: () => Promise<void>;
}

function getDisplayName(volume: Volume): string {
  return volume.display_name || volume.filename || volume.id;
}

function getShape(volume: Volume): string {
  const shape = volume.metadata?.shape || volume.metadata?.zarr?.shape;
  return Array.isArray(shape) ? shape.join(' × ') : 'Unknown';
}

function getGeometrySource(volume: Volume): string {
  return volume.metadata?.geometry_source || volume.metadata?.zarr?.geometry_source || 'Unknown';
}

function isDisplayable3D(volume: Volume): boolean {
  const is3d = volume.metadata?.is_3d;
  const shape = volume.metadata?.shape || volume.metadata?.zarr?.shape;
  return is3d !== false && Array.isArray(shape) && shape.length === 3;
}

export function DataManager({
  volumes,
  selectedVolume,
  onSelectVolume,
  onRefreshVolumes,
}: DataManagerProps) {
  const handleRename = async (volume: Volume) => {
    const currentName = getDisplayName(volume);
    const nextName = window.prompt('Volume display name:', currentName);

    if (!nextName || nextName.trim() === currentName) return;

    await updateVolume(volume.id, { display_name: nextName.trim() });
    await onRefreshVolumes();
  };

  const handleToggleHidden = async (volume: Volume) => {
    await updateVolume(volume.id, { hidden: !volume.hidden });
    await onRefreshVolumes();
  };

  const handleDelete = async (volume: Volume) => {
    const name = getDisplayName(volume);

    const confirmed = window.confirm(
      `Delete volume "${name}"?\n\nThis will remove the Zarr folder, sidecar header files, and registry entry.`
    );

    if (!confirmed) return;

    await deleteVolume(volume.id);
    await onRefreshVolumes();
  };

  return (
    <div className="data-manager">
      <div className="data-manager-header">
        <div>
          <h2>Data Manager</h2>
          <p>Manage uploaded SEG-Y conversions and Zarr volumes.</p>
        </div>
      </div>

      <div className="data-manager-table-wrap">
        <table className="data-manager-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Source File</th>
              <th>Shape</th>
              <th>Geometry</th>
              <th>Status</th>
              <th>Viewer</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            {volumes.map((volume) => {
              const displayName = getDisplayName(volume);
              const displayable = isDisplayable3D(volume);
              const selected = selectedVolume?.id === volume.id;

              return (
                <tr key={volume.id} className={selected ? 'selected-row' : ''}>
                  <td>
                    <div className="volume-name">
                      <Database size={14} />
                      <span>{displayName}</span>
                    </div>
                    <div className="volume-id">{volume.id}</div>
                  </td>

                  <td>{volume.filename}</td>
                  <td>{getShape(volume)}</td>
                  <td>{getGeometrySource(volume)}</td>

                  <td>
                    {displayable ? (
                      <span className="status-pill ready">Ready 3D</span>
                    ) : (
                      <span className="status-pill warning">Not 3D</span>
                    )}
                  </td>

                  <td>
                    {volume.hidden ? (
                      <span className="status-pill hidden">Hidden</span>
                    ) : (
                      <span className="status-pill visible">Visible</span>
                    )}
                  </td>

                  <td>
                    <div className="data-actions">
                      <button
                        onClick={() => onSelectVolume(volume)}
                        disabled={!displayable}
                        title="Load volume"
                      >
                        Load
                      </button>

                      <button onClick={() => handleRename(volume)} title="Rename">
                        <Edit3 size={14} />
                      </button>

                      <button onClick={() => handleToggleHidden(volume)} title="Hide/show in viewer dropdown">
                        {volume.hidden ? <Eye size={14} /> : <EyeOff size={14} />}
                      </button>

                      <button className="danger" onClick={() => handleDelete(volume)} title="Delete volume">
                        <Trash2 size={14} />
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })}

            {volumes.length === 0 && (
              <tr>
                <td colSpan={7} className="empty-table">
                  No converted volumes found.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  );
}
