function datasetIdFromIndexedVolumeId(volumeId: string | undefined | null): string | null {
  const prefix = 'indexed-segy-';
  if (!volumeId || !volumeId.startsWith(prefix)) return null;
  const datasetId = volumeId.slice(prefix.length).trim();
  return datasetId || null;
}

function metadataSummaryUrlForVolumeId(volumeId: string): string {
  const indexedDatasetId = datasetIdFromIndexedVolumeId(volumeId);
  return indexedDatasetId
    ? `/api/datasets/${indexedDatasetId}/metadata-summary`
    : `/api/volumes/${volumeId}/metadata-summary`;
}

function metadataCompletenessUrlForVolumeId(volumeId: string): string {
  const indexedDatasetId = datasetIdFromIndexedVolumeId(volumeId);
  return indexedDatasetId
    ? `/api/datasets/${indexedDatasetId}/metadata-completeness`
    : `/api/volumes/${volumeId}/metadata-summary`;
}

import { useEffect, useState } from 'react';

interface MetadataCompletenessPanelProps {
  volumeId: string;
}

function statusLabel(value: string | undefined): string {
  const labels: Record<string, string> = {
    complete: 'Complete',
    mostly_complete: 'Mostly complete',
    partial: 'Partial',
    weak: 'Weak',
  };

  return labels[value || ''] || value || '—';
}

function pct(value: any): string {
  const n = Number(value || 0);
  return `${Math.round(n * 100)}%`;
}

export function MetadataCompletenessPanel({ volumeId }: MetadataCompletenessPanelProps) {
  const [completeness, setCompleteness] = useState<any>(null);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    if (!volumeId) return;

    let cancelled = false;

    async function loadCompleteness() {
      setCompleteness(null);
      setError(null);

      try {
        const response = await fetch(metadataCompletenessUrlForVolumeId(volumeId));
        if (!response.ok) {
          throw new Error(`Metadata completeness request failed: ${response.status}`);
        }

        const summary = await response.json();

        if (!cancelled) {
          setCompleteness(summary?.metadata_quality || null);
        }
      } catch (err) {
        console.warn('Metadata completeness panel failed', err);
        if (!cancelled) {
          setError('Metadata completeness unavailable.');
        }
      }
    }

    loadCompleteness();

    return () => {
      cancelled = true;
    };
  }, [volumeId]);

  if (error) {
    return (
      <section id="metadata-scoring-table" className="info-section metadata-completeness-panel">
        <h3>Metadata Completeness</h3>
        <p>{error}</p>
      </section>
    );
  }

  if (!completeness) return null;

  const identity = completeness.completeness?.categories?.identity;
  const geometry = completeness.completeness?.categories?.geometry;
  const evidence = completeness.completeness?.categories?.evidence;
  const evidenceStrength = completeness.evidence_strength;
  const consistency = completeness.consistency;
  const metadataStatus = completeness.metadata_status;

  const missing = completeness.completeness?.missing_fields || [];
  const derived = completeness.completeness?.derived_fields || [];
  const warnings = [];

  return (
    <section id="metadata-scoring-table" className="info-section metadata-completeness-panel">
      <div className="metadata-completeness-header">
        <div>
          <h3>Metadata Completeness</h3>
          <p className="metadata-completeness-subtitle">
            Viewer-required metadata coverage based on identity, geometry, and evidence fields.
          </p>
        </div>
        <div className="metadata-completeness-score-block">
          <div className="metadata-completeness-score-line">
            <strong>{completeness.completeness?.percent}%</strong>
            <a
              className="metadata-score-learn-more-link"
              href={`/api/volumes/${volumeId}/metadata-score-report`}
              target="_blank"
              rel="noopener noreferrer"
              title="Open detailed metadata scoring report"
            >
              Learn more
            </a>
          </div>
          <span>{statusLabel(completeness.completeness?.status)}</span>
        </div>
      </div>

      <div className="metadata-completeness-category-grid">
        <div>
          <strong>Identity</strong>
          <span>{pct(identity?.score)} — {statusLabel(identity?.status)}</span>
        </div>
        <div>
          <strong>Geometry</strong>
          <span>{pct(geometry?.score)} — {statusLabel(geometry?.status)}</span>
        </div>
        <div>
          <strong>Evidence Coverage</strong>
          <span>{pct(evidence?.score)} — {statusLabel(evidence?.status)}</span>
        </div>
        <div>
          <strong>Evidence Strength</strong>
          <span>{statusLabel(evidenceStrength?.status)}</span>
        </div>
        <div>
          <strong>Consistency</strong>
          <span>{statusLabel(consistency?.status)} — {consistency?.checks_passed ?? 0} passed, {consistency?.checks_failed ?? 0} failed</span>
        </div>
        <div>
          <strong>Metadata Status</strong>
          <span>{statusLabel(metadataStatus?.status)}</span>
        </div>
      </div>

      {metadataStatus?.summary && (
        <p className="metadata-completeness-status-summary">{metadataStatus.summary}</p>
      )}

      {warnings.length > 0 && (
        <div className="metadata-completeness-detail">
          <strong>Warnings</strong>
          <ul>
            {warnings.map((item: string, index: number) => (
              <li key={`${item}-${index}`} style={{ fontSize: "12px", lineHeight: 1.3, margin: "2px 0" }}>{item}</li>
            ))}
          </ul>
        </div>
      )}

      {missing.length > 0 && (
        <div className="metadata-completeness-detail">
          <strong>Missing</strong>
          <ul>
            {missing.map((item: string) => (
              <li key={item} style={{ fontSize: "12px", lineHeight: 1.3, margin: "2px 0" }}>{item}</li>
            ))}
          </ul>
        </div>
      )}

      {derived.length > 0 && (
        <div className="metadata-completeness-detail">
          <strong>Derived</strong>
          <ul>
            {derived.map((item: string) => (
              <li key={item} style={{ fontSize: "12px", lineHeight: 1.3, margin: "2px 0" }}>{item}</li>
            ))}
          </ul>
        </div>
      )}
    </section>
  );
}
