import { useState, useEffect } from 'react'
import './App.css'
import { Seismic3DViewer } from './components/Seismic3DViewer'
import { Seismic2DViewer } from './components/Seismic2DViewer'
import { Seismic2DSurveyViewer } from './components/Seismic2DSurveyViewer'
import { DataManager } from './components/DataManager'
import { VolumeInfoPanel } from './components/VolumeInfoPanel'
import { LayoutGrid, Box, Image as ImageIcon, Settings, Upload, Database } from 'lucide-react'
import { getBackendSliceCacheInfo, getVolumes } from './services/zarrService'; import type { Volume } from './services/zarrService'
import axios from 'axios'

function getDatasetShape(volume: any): any[] | null {
  return volume?.metadata?.shape || volume?.metadata?.zarr?.shape || null;
}

function is3DVolume(volume: any): boolean {
  const shape = getDatasetShape(volume);
  const refreshDiagnostics = async () => {
    setDiagnosticsStatus('Checking...');

    try {
      await getVolumes();

      try {
        const cacheInfo = await getBackendSliceCacheInfo();
        setBackendCacheInfo(cacheInfo);
      } catch {
        setBackendCacheInfo(null);
      }

      setDiagnosticsStatus('Backend reachable');
      setDiagnosticsCheckedAt(new Date().toLocaleTimeString());
    } catch (err) {
      console.error('Diagnostics check failed', err);
      setDiagnosticsStatus('Backend not reachable');
      setDiagnosticsCheckedAt(new Date().toLocaleTimeString());
    }
  };

  return (
    Array.isArray(shape) &&
    shape.length === 3 &&
    volume?.metadata?.is_3d !== false &&
    (volume?.dataset_type === '3d_volume' || !volume?.dataset_type)
  );
}

function is2DLine(volume: any): boolean {
  const shape = getDatasetShape(volume);
  const refreshDiagnostics = async () => {
    setDiagnosticsStatus('Checking...');

    try {
      await getVolumes();

      try {
        const cacheInfo = await getBackendSliceCacheInfo();
        setBackendCacheInfo(cacheInfo);
      } catch {
        setBackendCacheInfo(null);
      }

      setDiagnosticsStatus('Backend reachable');
      setDiagnosticsCheckedAt(new Date().toLocaleTimeString());
    } catch (err) {
      console.error('Diagnostics check failed', err);
      setDiagnosticsStatus('Backend not reachable');
      setDiagnosticsCheckedAt(new Date().toLocaleTimeString());
    }
  };

  return (
    Array.isArray(shape) &&
    shape.length === 2 &&
    (volume?.dataset_type === '2d_line' || volume?.metadata?.is_3d === false)
  );
}

function is2DSurvey(volume: any): boolean {
  return volume?.dataset_type === '2d_survey';
}

function is2DDataset(volume: any): boolean {
  return is2DLine(volume) || is2DSurvey(volume);
}

function isDisplayableDataset(volume: any): boolean {
  if (volume?.hidden) return false;
  return is3DVolume(volume) || is2DDataset(volume);
}

function App() {
  const [viewMode, setViewMode] = useState<'3d' | '2d' | 'data' | 'info'>('3d');
  const [volumes, setVolumes] = useState<Volume[]>([]);
  const [selectedVolume, setSelectedVolume] = useState<Volume | null>(null);
  const [isUploading, setIsUploading] = useState(false);
  const [uploadMessage, setUploadMessage] = useState<string>('');
  const [diagnosticsOpen, setDiagnosticsOpen] = useState(false);
  const [diagnosticsTab, setDiagnosticsTab] = useState<'diagnostics' | 'backend' | 'frontend' | 'cache' | 'jobs' | 'settings'>('diagnostics');
  const [backendCacheInfo, setBackendCacheInfo] = useState<any>(null);
  const [diagnosticsStatus, setDiagnosticsStatus] = useState<string>('Not checked');
  const [diagnosticsCheckedAt, setDiagnosticsCheckedAt] = useState<string>('');

  useEffect(() => {
    refreshVolumes({ autoSelectIfNone: true, autoSelectReplacement: true });
  }, []);

  const refreshVolumes = async (
    options: { autoSelectIfNone?: boolean; autoSelectReplacement?: boolean } = {}
  ) => {
    const { autoSelectIfNone = false, autoSelectReplacement = false } = options;

    try {
      const v = await getVolumes();
      setVolumes(v);
      const displayableVolumes = v.filter((volume) => {
        if (viewMode === '2d') return is2DDataset(volume);
        if (viewMode === '3d') return is3DVolume(volume);
        return isDisplayableDataset(volume);
      });

      if (displayableVolumes.length > 0 && !selectedVolume && autoSelectIfNone) {
        setSelectedVolume(displayableVolumes[0]);
      }

      if (selectedVolume && !displayableVolumes.some((volume) => volume.id === selectedVolume.id)) {
        setSelectedVolume(autoSelectReplacement ? (displayableVolumes[0] || null) : null);
      }
    } catch (e) {
      console.error("Failed to fetch volumes", e);
    }
  };

  const switchViewerMode = (mode: '3d' | '2d') => {
    const candidates = volumes.filter((volume) =>
      mode === '3d' ? is3DVolume(volume) : is2DDataset(volume)
    );

    setViewMode(mode);

    setSelectedVolume((current) => {
      if (current && candidates.some((volume) => volume.id === current.id)) {
        return current;
      }

      return candidates[0] || null;
    });
  };

  const handleUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
    if (!e.target.files || e.target.files.length === 0) return;

    const file = e.target.files[0];
    const formData = new FormData();
    formData.append('file', file);

    const selectedVolumeBeforeUpload = selectedVolume;

    setIsUploading(true);
    setUploadMessage('Uploading SEG-Y file...');

    try {
      const uploadResponse = await axios.post('/api/upload', formData);
      const jobId = uploadResponse.data.job_id;

      if (!jobId) {
        throw new Error('Upload response did not include a job_id.');
      }

      setUploadMessage('SEG-Y upload accepted. Conversion queued.');

      const pollIntervalMs = 1000;
      const maxPolls = 600; // 10 minutes at 1 second intervals
      let pollCount = 0;

      await new Promise<void>((resolve, reject) => {
        const interval = window.setInterval(async () => {
          pollCount += 1;

          try {
            const jobResponse = await axios.get(`/api/jobs/${jobId}`);
            const job = jobResponse.data;

            setUploadMessage(job.message || `Job status: ${job.status}`);

            if (job.status === 'complete') {
              window.clearInterval(interval);

              // Fetch the updated registry directly without triggering refreshVolumes auto-selection.
              // Upload should add the volume to Data Manager/dropdown, but not open it.
              const updatedVolumes = await getVolumes();
              setVolumes(updatedVolumes);

              // Do not auto-load anything after upload.
              // The Data Manager "Load" button is the explicit open action.
              setSelectedVolume(null);
              setViewMode('data');

              resolve();
              return;
            }

            if (job.status === 'failed') {
              window.clearInterval(interval);
              reject(new Error(job.error || 'SEG-Y conversion failed.'));
              return;
            }

            if (pollCount >= maxPolls) {
              window.clearInterval(interval);
              reject(new Error('SEG-Y conversion timed out while waiting for job completion.'));
            }
          } catch (err) {
            window.clearInterval(interval);
            reject(err);
          }
        }, pollIntervalMs);
      });
    } catch (e) {
      console.error("Upload/conversion failed", e);
      const message = e instanceof Error ? e.message : "Upload failed. Check console for details.";
      alert(message);
    } finally {
      setIsUploading(false);
      setUploadMessage('');
      e.target.value = '';
    }
  };

  const refreshDiagnostics = async () => {
    setDiagnosticsStatus('Checking...');

    try {
      await getVolumes();

      try {
        const cacheInfo = await getBackendSliceCacheInfo();
        setBackendCacheInfo(cacheInfo);
      } catch {
        setBackendCacheInfo(null);
      }

      setDiagnosticsStatus('Backend reachable');
      setDiagnosticsCheckedAt(new Date().toLocaleTimeString());
    } catch (err) {
      console.error('Diagnostics check failed', err);
      setDiagnosticsStatus('Backend not reachable');
      setDiagnosticsCheckedAt(new Date().toLocaleTimeString());
    }
  };

  return (
    <div className="app-container">
      <nav className="sidebar">
        <div className="logo">Seismic Viewer</div>
        <button 
          className={viewMode === '3d' ? 'active' : ''} 
          onClick={() => switchViewerMode('3d')}
          title="3D View"
        >
          <Box size={24} />
          <span>3D View</span>
        </button>
        <button 
          className={viewMode === '2d' ? 'active' : ''} 
          onClick={() => switchViewerMode('2d')}
          title="2D View"
        >
          <ImageIcon size={24} />
          <span>2D View</span>
        </button>

        <button 
          className={viewMode === 'data' ? 'active' : ''} 
          onClick={() => setViewMode('data')}
          title="Data Manager"
        >
          <Database size={24} />
          <span>Data</span>
        </button>

        <button 
          className={viewMode === 'info' ? 'active' : ''} 
          onClick={() => setViewMode('info')}
          title="Selected Volume Info"
        >
          <LayoutGrid size={24} />
          <span>Info</span>
        </button>
        
        <div className="spacer"></div>
        
        <div className="upload-btn">
          <label htmlFor="segy-upload">
            <Upload size={24} color={isUploading ? "#aaa" : "#4a9eff"} style={{ cursor: 'pointer' }} />
            <input 
              id="segy-upload" 
              type="file" 
              accept=".sgy,.segy" 
              style={{ display: 'none' }} 
              onChange={handleUpload}
              disabled={isUploading}
            />
          </label>
        </div>

        <button
          className={diagnosticsOpen ? 'active' : ''}
          title="Settings / Diagnostics"
          onClick={() => {
            setDiagnosticsOpen(true);
            refreshDiagnostics();
          }}
        >
          <Settings size={24} />
          <span>Settings</span>
        </button>
      </nav>

      {diagnosticsOpen && (
        <aside
          style={{
            position: 'fixed',
            left: 82,
            top: 0,
            bottom: 0,
            width: 420,
            zIndex: 100,
            background: '#181818',
            color: 'white',
            borderRight: '1px solid #333',
            boxShadow: '6px 0 20px rgba(0,0,0,0.35)',
            display: 'flex',
            flexDirection: 'column',
          }}
        >
          <div
            style={{
              padding: '14px 16px',
              borderBottom: '1px solid #333',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
              gap: 12,
            }}
          >
            <div>
              <div style={{ fontSize: 16, fontWeight: 700 }}>Settings / Diagnostics</div>
              <div style={{ fontSize: 12, opacity: 0.65 }}>Application status and service checks</div>
            </div>

            <button
              onClick={() => setDiagnosticsOpen(false)}
              style={{
                background: '#333',
                color: 'white',
                border: '1px solid #555',
                borderRadius: 4,
                padding: '5px 9px',
                cursor: 'pointer',
              }}
            >
              Close
            </button>
          </div>

          <div
            style={{
              display: 'flex',
              gap: 6,
              flexWrap: 'wrap',
              padding: '10px 12px',
              borderBottom: '1px solid #333',
            }}
          >
            {([
              ['diagnostics', 'Diagnostics'],
              ['backend', 'Backend'],
              ['frontend', 'Frontend'],
              ['cache', 'Cache'],
              ['jobs', 'Jobs'],
              ['settings', 'Settings'],
            ] as const).map(([key, label]) => (
              <button
                key={key}
                onClick={() => setDiagnosticsTab(key)}
                style={{
                  background: diagnosticsTab === key ? '#4a4a4a' : '#2b2b2b',
                  color: 'white',
                  border: diagnosticsTab === key ? '1px solid #aaa' : '1px solid #555',
                  borderRadius: 4,
                  padding: '5px 8px',
                  cursor: 'pointer',
                  fontSize: 12,
                }}
              >
                {label}
              </button>
            ))}
          </div>

          <div style={{ padding: 16, overflowY: 'auto', fontSize: 13, lineHeight: 1.45 }}>
            {diagnosticsTab === 'diagnostics' && (
              <>
                <h3 style={{ marginTop: 0 }}>Diagnostics</h3>
                <p>Status: <strong>{diagnosticsStatus}</strong></p>
                <p>Last checked: {diagnosticsCheckedAt || '—'}</p>
                <button
                  onClick={refreshDiagnostics}
                  style={{ background: '#333', color: 'white', border: '1px solid #555', borderRadius: 4, padding: '6px 10px', cursor: 'pointer' }}
                >
                  Refresh diagnostics
                </button>

                <hr style={{ borderColor: '#333', margin: '16px 0' }} />

                <div>Viewer mode: <strong>{viewMode}</strong></div>
                <div>Selected dataset: <strong>{selectedVolume?.display_name || selectedVolume?.filename || 'None'}</strong></div>
                <div>Selected type: <strong>{selectedVolume?.dataset_type || '—'}</strong></div>
                <div>Registered datasets: <strong>{volumes.length}</strong></div>
              </>
            )}

            {diagnosticsTab === 'backend' && (
              <>
                <h3 style={{ marginTop: 0 }}>Backend</h3>
                <div>Status: <strong>{diagnosticsStatus}</strong></div>
                <div>API base: <strong>{window.location.origin}</strong></div>
                <div>Last checked: {diagnosticsCheckedAt || '—'}</div>
                <p style={{ opacity: 0.7 }}>This checks whether the viewer can reach the backend API through /api/volumes.</p>
              </>
            )}

            {diagnosticsTab === 'frontend' && (
              <>
                <h3 style={{ marginTop: 0 }}>Frontend</h3>
                <div>Route: <strong>{window.location.href}</strong></div>
                <div>Viewer mode: <strong>{viewMode}</strong></div>
                <div>2D datasets: <strong>{volumes.filter(v => v.dataset_type === '2d_line' || v.dataset_type === '2d_survey').length}</strong></div>
                <div>3D datasets: <strong>{volumes.filter(v => v.dataset_type === '3d_volume').length}</strong></div>
                <div>Unknown datasets: <strong>{volumes.filter(v => !v.dataset_type || v.dataset_type === 'unknown').length}</strong></div>
              </>
            )}

            {diagnosticsTab === 'cache' && (
              <>
                <h3 style={{ marginTop: 0 }}>Cache</h3>
                <div>
                  Backend slice cache:{' '}
                  <strong>
                    {backendCacheInfo
                      ? `${backendCacheInfo.entries} entries · ${(backendCacheInfo.bytes / 1048576).toFixed(1)} MB / ${(backendCacheInfo.max_bytes / 1048576).toFixed(0)} MB`
                      : 'not available'}
                  </strong>
                </div>
                <p style={{ opacity: 0.7 }}>Detailed 3D frontend slice cache status remains inside the 3D viewer performance panel for now.</p>
              </>
            )}

            {diagnosticsTab === 'jobs' && (
              <>
                <h3 style={{ marginTop: 0 }}>Jobs</h3>
                <div>Upload/conversion active: <strong>{isUploading ? 'Yes' : 'No'}</strong></div>
                <div>Current message: <strong>{uploadMessage || '—'}</strong></div>
                <p style={{ opacity: 0.7 }}>A fuller job history can be added once the backend exposes recent job records.</p>
              </>
            )}

            {diagnosticsTab === 'settings' && (
              <>
                <h3 style={{ marginTop: 0 }}>Settings</h3>
                <p>Reserved for application-level preferences.</p>
                <p style={{ opacity: 0.7 }}>Examples: default 2D display mode, default clip percentile, cache limits, startup behavior, and diagnostics verbosity.</p>
              </>
            )}
          </div>
        </aside>
      )}


      <main className="content">
        <header className="top-bar">
          <div className="title">
            {viewMode === '3d' ? '3D Cube Visualization' : viewMode === '2d' ? '2D Section Viewer' : viewMode === 'data' ? 'Data Manager' : 'Volume Information'}
          </div>
          
          <div className="controls">
            <Database size={16} />
            <select 
              value={selectedVolume?.id || ''} 
              onChange={(e) => setSelectedVolume(volumes.find(v => v.id === e.target.value) || null)}
              className="volume-select"
              disabled={viewMode === 'data' || viewMode === 'info'}
            >
              <option value="" disabled>Select Volume</option>
              {volumes
                .filter((v) => {
                  if (viewMode === '3d') return is3DVolume(v);
                  if (viewMode === '2d') return is2DDataset(v);
                  return isDisplayableDataset(v);
                })
                .map(v => (
                  <option key={v.id} value={v.id}>{v.display_name || v.filename}</option>
                ))}
            </select>
          </div>
        </header>

        {isUploading && (
          <div className="upload-status-bar">
            <span className="upload-status-dot"></span>
            <span>{uploadMessage || 'Processing SEG-Y...'}</span>
          </div>
        )}

        <div className="viewer-area">
          {viewMode === 'data' ? (
            <DataManager
              volumes={volumes}
              selectedVolume={selectedVolume}
              onSelectVolume={(volume) => {
                if (volume.hidden) {
                  setSelectedVolume((current) => current?.id === volume.id ? null : current);
                  return;
                }

                setSelectedVolume(volume);
                setViewMode(is2DDataset(volume) ? '2d' : '3d');
              }}
              onRefreshVolumes={() => refreshVolumes({ autoSelectIfNone: false, autoSelectReplacement: false })}
            />
          ) : viewMode === 'info' ? (
            <VolumeInfoPanel volume={selectedVolume} />
          ) : selectedVolume ? (
            viewMode === '3d' && is3DVolume(selectedVolume) ? (
              <Seismic3DViewer zarrPath={selectedVolume.zarr_url} key={`3d-${selectedVolume.id}`} />
            ) : viewMode === '2d' && is2DLine(selectedVolume) ? (
              <Seismic2DViewer
                zarrPath={selectedVolume.zarr_url}
                dim={0}
                lineInfo={selectedVolume}
                defaultShowLineInfo={true}
                key={`2d-${selectedVolume.id}`}
              />
            ) : viewMode === '2d' && is2DSurvey(selectedVolume) ? (
              <Seismic2DSurveyViewer
                surveyId={selectedVolume.id}
                surveyName={selectedVolume.display_name || selectedVolume.filename}
                key={`survey-${selectedVolume.id}`}
              />
            ) : viewMode === '3d' ? (
              <div className="no-data">No 3D dataset selected. Choose a 3D volume from the dropdown or Data Manager.</div>
            ) : viewMode === '2d' ? (
              <div className="no-data">No 2D dataset selected. Choose a 2D line or survey from the dropdown or Data Manager.</div>
            ) : (
              <div className="no-data">Selected dataset type is not supported by this viewer.</div>
            )
          ) : (
            <div className="no-data">
              {isUploading ? (uploadMessage || 'Processing SEG-Y...') : 'No volumes found. Please upload a SEG-Y file.'}
            </div>
          )}
        </div>
      </main>
    </div>
  )
}

export default App
