      const formation = configured.find((column) => column.key === 'formation');
      if (formation) return formation;
    }
  } catch { /* use defaults */ }
  return INTERVAL_BUILDER_DEFAULTS.find((column) => column.key === 'formation') ?? {
    key: 'formation',
    label: 'Formation Tops',
    enabled: true,
    width: 120,
    title: 'Formation',
  };
}


