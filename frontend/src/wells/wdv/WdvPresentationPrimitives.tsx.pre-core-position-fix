        .filter(Boolean);
    if (mnemonics.length === 0)
        return track.title || 'Curve Track';
    return mnemonics.join(' / ');
}
export function valueToX(value: number, assignment: CurveAssignment, lattice: CurveTrack['lattice'], trackWidth: number): number {
