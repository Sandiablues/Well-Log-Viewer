{
  "name": "well-log-viewer-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "MultiViewer Well Log Viewer — Frontend (WL-BUILD-001 scaffold)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@equinor/videx-wellog": "^1.4.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "notes": [
    "webviz-subsurface-components is explicitly NOT included.",
    "@equinor/videx-wellog is the frontend rendering dependency only.",
    "It must remain behind the equinorWellLogAdapter — never called directly from page or shell components."
  ]
}
