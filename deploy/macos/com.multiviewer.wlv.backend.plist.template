<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.multiviewer.wlv.backend</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT__/scripts/wlv_backend_service.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>WLV_PROJECT</key>
    <string>__PROJECT__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__PROJECT__/.wlv_runtime/logs/wlv_backend_launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT__/.wlv_runtime/logs/wlv_backend_launchd.err.log</string>
</dict>
</plist>
