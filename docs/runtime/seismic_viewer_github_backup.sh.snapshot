#!/usr/bin/env bash
set -euo pipefail

REPO="$HOME/Desktop/Seismic_Viewer/seismic_viewer_project"
ACTIVE="$HOME/Applications/MultiViewer/seismic_viewer_project"
RUNTIME="$HOME/Applications/MultiViewer"

echo "=== Seismic Viewer GitHub Backup ==="
echo "Git repo:       $REPO"
echo "Active app dir: $ACTIVE"
echo "Runtime dir:    $RUNTIME"
echo

if [ ! -d "$REPO/.git" ]; then
  echo "ERROR: Git repo not found at $REPO"
  exit 1
fi

if [ ! -d "$ACTIVE" ]; then
  echo "ERROR: Active app folder not found at $ACTIVE"
  exit 1
fi

echo "0) Pre-backup runtime check..."
LISTENERS="$(lsof -tiTCP:8000 -sTCP:LISTEN 2>/dev/null || true)"
LISTENER_COUNT="$(printf "%s\n" "$LISTENERS" | sed '/^$/d' | wc -l | tr -d ' ')"

if [ "$LISTENER_COUNT" = "1" ]; then
  echo "  OK: one backend listener on port 8000: $LISTENERS"
else
  echo "  WARNING: expected one backend listener on port 8000; found $LISTENER_COUNT"
  lsof -nP -iTCP:8000 -sTCP:LISTEN 2>/dev/null || true
fi

cd "$REPO"

echo
echo "1) Checking branch..."
git branch --show-current

echo
echo "2) Syncing source directories..."

RSYNC_EXCLUDES=(
  --exclude "__pycache__/"
  --exclude "*.pyc"
  --exclude ".pytest_cache/"
  --exclude ".DS_Store"
  --exclude "*.bak*"
  --exclude "*.before_*"
  --exclude "*.broken_*"
  --exclude "*.tmp"
  --exclude "data/"
  --exclude "logs/"
  --exclude "run/"
  --exclude "uploads/"
  --exclude "zarr/"
  --exclude "zarr_tmp/"
  --exclude "backend_*.log"
  --exclude "node_modules/"
  --exclude "dist/"
)

sync_dir() {
  local rel="$1"
  local src="$ACTIVE/$rel/"
  local dst="$REPO/$rel/"

  if [ -d "$src" ]; then
    mkdir -p "$dst"
    rsync -a --delete "${RSYNC_EXCLUDES[@]}" "$src" "$dst"
    echo "  synced dir: $rel"
  else
    echo "  skipped missing dir: $rel"
  fi
}

sync_file() {
  local rel="$1"
  local src="$ACTIVE/$rel"
  local dst="$REPO/$rel"

  if [ -f "$src" ]; then
    mkdir -p "$(dirname "$dst")"
    rsync -a "$src" "$dst"
    echo "  synced file: $rel"
  else
    echo "  skipped missing file: $rel"
  fi
}

sync_file "seismic-viewer-backend/main.py"
sync_dir  "seismic-viewer-backend/app/api"
sync_dir  "seismic-viewer-backend/app/msi"
sync_dir  "seismic-viewer-backend/app/services"
sync_dir  "seismic-viewer-backend/app/reports"
sync_dir  "seismic-viewer-backend/scripts"

sync_dir  "seismic-viewer-frontend/src"
sync_file "seismic-viewer-frontend/package.json"
sync_file "seismic-viewer-frontend/package-lock.json"
sync_file "seismic-viewer-frontend/index.html"
sync_file "seismic-viewer-frontend/vite.config.ts"
sync_file "seismic-viewer-frontend/tsconfig.json"
sync_file "seismic-viewer-frontend/tsconfig.app.json"
sync_file "seismic-viewer-frontend/tsconfig.node.json"

sync_dir "docs"

echo
echo "2b) Syncing runtime snapshots..."
mkdir -p "$REPO/docs/runtime"

if [ -f "$RUNTIME/launch_multiviewer.sh" ]; then
  rsync -a "$RUNTIME/launch_multiviewer.sh" "$REPO/docs/runtime/launch_multiviewer.sh.snapshot"
  echo "  synced: docs/runtime/launch_multiviewer.sh.snapshot"
fi

rsync -a "$HOME/Scripts/seismic_viewer_github_backup.sh" "$REPO/docs/runtime/seismic_viewer_github_backup.sh.snapshot"
echo "  synced: docs/runtime/seismic_viewer_github_backup.sh.snapshot"

echo
echo "3) Staging source tree..."

git add \
  seismic-viewer-backend/main.py \
  seismic-viewer-backend/app/api \
  seismic-viewer-backend/app/msi \
  seismic-viewer-backend/app/services \
  seismic-viewer-backend/app/reports \
  seismic-viewer-backend/scripts \
  seismic-viewer-frontend/src \
  seismic-viewer-frontend/package.json \
  seismic-viewer-frontend/package-lock.json \
  seismic-viewer-frontend/index.html \
  seismic-viewer-frontend/vite.config.ts \
  seismic-viewer-frontend/tsconfig.json \
  seismic-viewer-frontend/tsconfig.app.json \
  seismic-viewer-frontend/tsconfig.node.json \
  docs

echo
echo "4) Staged changes:"
git diff --cached --stat -- ':!*.before_*' ':!*.bak*' ':!*.broken_*' || true

if git diff --cached --quiet; then
  echo
  echo "No source changes staged. Nothing to commit."
  git status --short
  exit 0
fi

echo
echo "5) Committing..."
git commit -m "Backup Seismic Viewer source tree"

echo
echo "6) Pushing..."
git push

echo
echo "Backup complete."
