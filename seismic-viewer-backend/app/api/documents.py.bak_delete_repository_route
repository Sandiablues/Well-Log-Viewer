@router.post("/segy-files/{segy_file_id}/convert")
def api_convert_registry_segy_file(segy_file_id: str):
    segy_file = get_segy_file(segy_file_id)
    if not segy_file:
        raise HTTPException(status_code=404, detail="SEG-Y file not found")

    if segy_file.get("conversion_status") in {"queued", "converting"}:
        return {
            "status": segy_file.get("conversion_status"),
            "message": "Conversion is already queued or running.",
            "segy_file": segy_file,
        }

    try:
        input_path = resolve_repository_path(
            segy_file["repository_id"],
            segy_file["relative_path"],
        )
    except Exception as exc:
        updated = update_segy_file_conversion(
            segy_file_id=segy_file_id,
            conversion_status="error",
            error=str(exc),
        )
        raise HTTPException(status_code=400, detail={
            "message": "Failed to resolve SEG-Y source path",
            "error": str(exc),
            "segy_file": updated,
        })

    if not input_path.exists() or not input_path.is_file():
        updated = update_segy_file_conversion(
            segy_file_id=segy_file_id,
            conversion_status="error",
            error=f"Source SEG-Y file missing: {input_path}",
        )
        raise HTTPException(status_code=404, detail={
            "message": "Source SEG-Y file missing",
            "path": str(input_path),
            "segy_file": updated,
        })

    file_id = str(uuid.uuid4())
    job_id = str(uuid.uuid4())

    os.makedirs(ZARR_DIR, exist_ok=True)
    os.makedirs(ZARR_TMP_DIR, exist_ok=True)
    os.makedirs(JOBS_DIR, exist_ok=True)

    output_path = os.path.join(ZARR_DIR, f"{file_id}.zarr")
    temp_output_path = os.path.join(ZARR_TMP_DIR, f"{file_id}.zarr.tmp")
    zarr_url = f"/data/zarr/{file_id}.zarr"

    registry_job_service.create_job(
        job_id=job_id,
        file_id=file_id,
        filename=segy_file.get("filename") or input_path.name,
        input_path=str(input_path),
        output_path=output_path,
        temp_output_path=temp_output_path,
    )

    updated = update_segy_file_conversion(
        segy_file_id=segy_file_id,
        conversion_status="queued",
        volume_id=file_id,
        job_id=job_id,
        zarr_url=zarr_url,
    )

    registry_conversion_executor.submit(registry_conversion_job_service.run, job_id)

    return {
        "status": "queued",
        "message": "Registry SEG-Y conversion queued.",
        "job_id": job_id,
        "volume_id": file_id,
        "zarr_url": zarr_url,
        "segy_file": updated,
    }

@router.post("/segy-files/{segy_file_id}/refresh-status")
def api_refresh_registry_segy_file_status(segy_file_id: str):
    segy_file = get_segy_file(segy_file_id)
    if not segy_file:
        raise HTTPException(status_code=404, detail="SEG-Y file not found")

    job_id = segy_file.get("job_id")
    if not job_id:
        return {
            "status": segy_file.get("conversion_status", "not_converted"),
            "message": "No job_id is attached to this SEG-Y registry item.",
            "segy_file": segy_file,
        }

    job = registry_job_service.get_job(job_id)
    if not job:
        raise HTTPException(status_code=404, detail=f"Job not found: {job_id}")

    job_status = str(job.get("status", "")).lower()
    job_error = job.get("error")

    completed_statuses = {"completed", "complete", "done", "success", "succeeded", "finished"}
    failed_statuses = {"failed", "error", "errored"}

    if job_error:
        updated = update_segy_file_conversion(
            segy_file_id=segy_file_id,
            conversion_status="error",
            error=str(job_error),
        )
    elif job_status in completed_statuses:
        updated = update_segy_file_conversion(
            segy_file_id=segy_file_id,
            conversion_status="converted",
            volume_id=segy_file.get("volume_id"),
            job_id=job_id,
            zarr_url=segy_file.get("zarr_url"),
            error=None,
        )
        # Clear stale error from earlier failed attempts.
        files = list_segy_files(repository_id=updated.get("repository_id"))
        # Direct file rewrite is handled through helper below.
        from app.services.package_registry_service import SEGY_FILES_PATH, _read_json_list, _write_json_list
        all_files = _read_json_list(SEGY_FILES_PATH)
        for item in all_files:
            if item.get("segy_file_id") == segy_file_id:
                item.pop("conversion_error", None)
                updated = item
                break
        _write_json_list(SEGY_FILES_PATH, all_files)

        # Ensure the converted registry item is represented as a normal Data Manager volume.
        _attach_registry_source_to_volume(updated)
    elif job_status in failed_statuses:
        updated = update_segy_file_conversion(
            segy_file_id=segy_file_id,
            conversion_status="error",
            error=str(job.get("message") or "Conversion job failed"),
        )
    else:
        updated = update_segy_file_conversion(
            segy_file_id=segy_file_id,
            conversion_status="converting",
            volume_id=segy_file.get("volume_id"),
            job_id=job_id,
            zarr_url=segy_file.get("zarr_url"),
        )

    return {
        "status": updated.get("conversion_status"),
        "job_status": job.get("status"),
        "job_id": job_id,
        "volume_id": updated.get("volume_id"),
        "zarr_url": updated.get("zarr_url"),
        "segy_file": updated,
        "job": job,
    }




# Volume-scoped supporting documents.
# This keeps the Info tab from showing every document in a repository.
VOLUME_DOCUMENTS_DATA_DIR = Path(__file__).resolve().parents[2] / "data"


def _volume_doc_get_volume(volume_id: str) -> dict:
    volumes_path = VOLUME_DOCUMENTS_DATA_DIR / "volumes.json"
    if not volumes_path.exists():
        return {}

    data = json.loads(volumes_path.read_text(encoding="utf-8"))

    if isinstance(data, dict):
        if volume_id in data:
            return data[volume_id] or {}

        for value in data.values():
            if isinstance(value, dict) and value.get("id") == volume_id:
                return value

    if isinstance(data, list):
        for value in data:
            if isinstance(value, dict) and value.get("id") == volume_id:
                return value

    return {}


def _volume_doc_source(volume: dict) -> dict:
    metadata = volume.get("metadata") or {}
    source = volume.get("source") or {}

    return {
        "repository_id": source.get("repository_id") or metadata.get("repository_id"),
        "package_id": source.get("package_id") or metadata.get("package_id"),
        "line_id": source.get("line_id") or metadata.get("line_id"),
        "segy_file_id": source.get("segy_file_id") or metadata.get("segy_file_id"),
        "package_display_name": source.get("package_display_name") or metadata.get("package_display_name"),
        "line_display_name": source.get("line_display_name") or metadata.get("line_display_name"),
        "original_relative_path": source.get("original_relative_path") or metadata.get("original_relative_path"),
    }


def _volume_doc_matches(doc: dict, source: dict) -> bool:
    package_id = str(source.get("package_id") or "").strip().lower()
    line_id = str(source.get("line_id") or "").strip().lower()
    segy_file_id = str(source.get("segy_file_id") or "").strip().lower()

    source_rel = str(source.get("original_relative_path") or "").strip()
    source_package = source_rel.split("/")[0].strip().lower() if "/" in source_rel else ""

    package_display = str(source.get("package_display_name") or "").strip().lower()
    package_tokens = [x for x in {source_package, package_display} if x]

    doc_package_id = str(doc.get("package_id") or "").strip().lower()
    doc_line_id = str(doc.get("line_id") or "").strip().lower()
    doc_segy_file_id = str(doc.get("segy_file_id") or "").strip().lower()
    rel_path = str(doc.get("relative_path") or "").strip().lower()
    filename = str(doc.get("filename") or "").strip().lower()

    if package_id and doc_package_id and doc_package_id == package_id:
        return True

    if line_id and doc_line_id and doc_line_id == line_id:
        return True

    if segy_file_id and doc_segy_file_id and doc_segy_file_id == segy_file_id:
        return True

    for token in package_tokens:
        if rel_path == token or rel_path.startswith(f"{token}/") or filename.startswith(token) or token in filename:
            return True

    return False


@router.get("/volumes/{volume_id}/documents")
def api_list_volume_documents(volume_id: str):
    volume = _volume_doc_get_volume(volume_id)
    source = _volume_doc_source(volume)

    repository_id = source.get("repository_id")
    if not repository_id:
        return {
            "volume_id": volume_id,
            "source": source,
            "documents": [],
            "warning": "Selected volume has no repository source metadata.",
        }

    docs = list_documents(repository_id=repository_id)

    scoped_docs = [
        doc for doc in docs
        if _volume_doc_matches(doc, source)
    ]

    return {
        "volume_id": volume_id,
        "source": source,
        "documents": scoped_docs,
        "document_count": len(scoped_docs),
    }
