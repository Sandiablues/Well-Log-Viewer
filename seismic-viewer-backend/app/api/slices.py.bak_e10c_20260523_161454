from __future__ import annotations

from fastapi import APIRouter, Query

from app.api import endpoints as legacy_endpoints

router = APIRouter(tags=["slices"])


@router.get("/slice")
def get_raw_zarr_slice(
    zarr_path: str = Query(..., description="Zarr path, e.g. /data/zarr/f3_seismic.zarr"),
    dim: int = Query(..., ge=0, le=2),
    index: int = Query(..., ge=0),
    max_size: int = Query(1000, ge=64, le=4096),
):
    return legacy_endpoints.get_raw_zarr_slice(
        zarr_path=zarr_path,
        dim=dim,
        index=index,
        max_size=max_size,
    )


@router.get("/slice/cache-info")
def get_slice_cache_info():
    return legacy_endpoints.get_slice_cache_info()


@router.post("/slice/clear-cache")
def clear_slice_cache():
    return legacy_endpoints.clear_slice_cache()
