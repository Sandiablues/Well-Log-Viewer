def load_volumes():
    if os.path.exists(VOLUMES_JSON):
        with open(VOLUMES_JSON, "r") as f:
            return json.load(f)
    return {}

def save_volumes(volumes):
    with open(VOLUMES_JSON, "w") as f:
        json.dump(volumes, f)


def infer_dataset_type(volume):
    """
    Infer dataset type for older records that do not yet have dataset_type.
    This is intentionally conservative and based only on existing metadata.
    """
    metadata = volume.get("metadata") or {}
    zarr_metadata = metadata.get("zarr") or {}
    shape = metadata.get("shape") or zarr_metadata.get("shape")

    if volume.get("dataset_type"):
        return volume.get("dataset_type")

    if metadata.get("is_3d") is True and isinstance(shape, list) and len(shape) == 3:
        return "3d_volume"

    if metadata.get("is_3d") is False:
        return "2d_line"

    if isinstance(shape, list) and len(shape) == 2:
        return "2d_line"

    if isinstance(shape, list) and len(shape) == 3:
        return "3d_volume"

    return "unknown"


def normalize_volume_record(volume):
    normalized = dict(volume)
    normalized["dataset_type"] = infer_dataset_type(normalized)
    return normalized

@router.post("/upload")
async def upload_segy(file: UploadFile = File(...)):
    file_id = str(uuid.uuid4())
    job_id = str(uuid.uuid4())

    os.makedirs(UPLOAD_DIR, exist_ok=True)
    os.makedirs(ZARR_DIR, exist_ok=True)
    os.makedirs(ZARR_TMP_DIR, exist_ok=True)
    os.makedirs(JOBS_DIR, exist_ok=True)

    file_path = os.path.join(UPLOAD_DIR, f"{file_id}.sgy")
    output_path = os.path.join(ZARR_DIR, f"{file_id}.zarr")
    temp_output_path = os.path.join(ZARR_TMP_DIR, f"{file_id}.zarr.tmp")

    with open(file_path, "wb") as buffer:
        shutil.copyfileobj(file.file, buffer)

    job_service.create_job(
        job_id=job_id,
        file_id=file_id,
        filename=file.filename,
        input_path=file_path,
        output_path=output_path,
        temp_output_path=temp_output_path,
    )

    conversion_executor.submit(conversion_job_service.run, job_id)

    return {
        "job_id": job_id,
        "file_id": file_id,
        "status": "queued",
        "message": "SEG-Y upload accepted. Conversion started.",
    }





