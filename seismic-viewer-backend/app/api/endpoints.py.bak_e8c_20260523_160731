@router.post("/volumes/{volume_id}/metadata/enrich")
async def enrich_volume_metadata(volume_id: str):
    """
    Build deterministic normalized metadata from existing sidecar evidence.

    Current prototype storage writes .normalized_metadata.json beside the Zarr volume.
    Repository isolation keeps this compatible with a later enterprise metadata store.
    """
    try:
        normalized = build_normalized_metadata(volume_id)
        return {
            "status": "ok",
            "volume_id": volume_id,
            "normalized_metadata": normalized,
        }
    except FileNotFoundError as exc:
        raise HTTPException(status_code=404, detail=str(exc))
    except Exception as exc:
        raise HTTPException(status_code=500, detail=f"Metadata enrichment failed: {exc}")




def _score_report_status_label(value):
    labels = {
        "complete": "Complete",
        "mostly_complete": "Mostly complete",
        "partial": "Partial",
        "weak": "Weak",
        "strong": "Strong",
        "moderate": "Moderate",
        "limited": "Limited",
        "consistent": "Consistent",
        "mostly_consistent": "Mostly consistent",
        "inconsistent_with_warnings": "Inconsistent with warnings",
        "inconsistent": "Inconsistent",
        "unknown": "Unknown",
        "usable": "Usable",
        "usable_with_warnings": "Usable with warnings",
        "incomplete": "Incomplete",
        "needs_review": "Needs review",
    }
    return labels.get(str(value or ""), str(value or "—"))


def _score_report_percent(value):
    try:
        return f"{round(float(value) * 100)}%"
    except Exception:
        return "—"


def _score_report_list(items):
    if not items:
        return "<p class='muted'>None.</p>"
    return "<ul>" + "".join(f"<li><code>{escape(str(item))}</code></li>" for item in items) + "</ul>"


def _score_report_checks(checks):
    if not checks:
        return "<p class='muted'>No consistency checks available.</p>"

    rows = []
    for check in checks:
        status = escape(_score_report_status_label(check.get("status")))
        name = escape(str(check.get("name") or "Unnamed check"))
        left = escape(str(check.get("left")))
        right = escape(str(check.get("right")))
        left_source = escape(str(check.get("left_source") or ""))
        right_source = escape(str(check.get("right_source") or ""))

        rows.append(
            "<tr>"
            f"<td>{name}</td>"
            f"<td><span class='status'>{status}</span></td>"
            f"<td>{left_source}: <code>{left}</code></td>"
            f"<td>{right_source}: <code>{right}</code></td>"
            "</tr>"
        )

    return (
        "<table>"
        "<thead><tr><th>Check</th><th>Status</th><th>Left</th><th>Right</th></tr></thead>"
        "<tbody>"
        + "".join(rows)
        + "</tbody></table>"
    )


def _score_report_sources(sources):
    if not sources:
        return "<p class='muted'>No evidence sources available.</p>"

    rows = []
    for source in sources:
        rows.append(
            "<tr>"
            f"<td>{escape(str(source.get('source') or '—'))}</td>"
            f"<td>{escape(str(source.get('rank') if source.get('rank') is not None else '—'))}</td>"
            "</tr>"
        )

    return (
        "<table>"
        "<thead><tr><th>Evidence Source</th><th>Rank</th></tr></thead>"
        "<tbody>"
        + "".join(rows)
        + "</tbody></table>"
    )


