@router.get("/volumes/{volume_id}/metadata/normalized")
async def get_volume_normalized_metadata(volume_id: str):
    """
    Return normalized metadata for a volume.

    If normalized metadata does not exist yet, build it automatically from
    the available sidecars and conversion metadata.
    """
    try:
        normalized = get_normalized_metadata(volume_id)

        if normalized is None:
            normalized = build_normalized_metadata(volume_id)

        return {
            "volume_id": volume_id,
            "normalized_metadata": normalized,
        }

    except Exception as e:
        raise HTTPException(
            status_code=500,
            detail=f"Failed to get or build normalized metadata for volume_id={volume_id}: {e}",
        )
