@router.patch("/volumes/{volume_id}")
async def update_volume(volume_id: str, updates: Dict[str, Any]):
    volumes = load_volumes()

    if volume_id not in volumes:
        raise HTTPException(status_code=404, detail="Volume not found")

    allowed_fields = {
        "display_name",
        "hidden",
        "description",
    }

    for key, value in updates.items():
        if key in allowed_fields:
            volumes[volume_id][key] = value

    save_volumes(volumes)
    return volumes[volume_id]


@router.delete("/volumes/{volume_id}")
async def delete_volume(volume_id: str):
    volumes = load_volumes()

    if volume_id not in volumes:
        raise HTTPException(status_code=404, detail="Volume not found")

    volume = volumes[volume_id]
    zarr_url = volume.get("zarr_url")

    deleted_paths = []

    if zarr_url and zarr_url.startswith("/data/zarr/"):
        zarr_name = zarr_url.replace("/data/zarr/", "", 1)
        zarr_path = Path(ZARR_DIR) / zarr_name

        # Delete the Zarr directory.
        if zarr_path.exists():
            shutil.rmtree(zarr_path)
            deleted_paths.append(str(zarr_path))

        # Delete sidecar files:
        # <id>.zarr.viewer_metadata.json
        # <id>.zarr.trace_header_summary.json
        # <id>.zarr.segy_binary_header.json
        # <id>.zarr.segy_text_header.txt
        for sidecar in Path(ZARR_DIR).glob(zarr_name + ".*"):
            if sidecar.exists():
                sidecar.unlink()
                deleted_paths.append(str(sidecar))

    del volumes[volume_id]
    save_volumes(volumes)

    return {
        "deleted": True,
        "volume_id": volume_id,
        "deleted_paths": deleted_paths,
    }

# --- Volume info / SEG-Y header API ---

def _volume_sidecar_paths(volume: Dict[str, Any]) -> Dict[str, Path]:
    zarr_url = volume.get("zarr_url", "")

    if not zarr_url.startswith("/data/zarr/"):
        raise HTTPException(status_code=400, detail="Volume does not have a valid Zarr URL")

    zarr_name = zarr_url.replace("/data/zarr/", "", 1)
    base = Path(ZARR_DIR) / zarr_name

    return {
        "viewer_metadata": Path(str(base) + ".viewer_metadata.json"),
        "text_header": Path(str(base) + ".segy_text_header.txt"),
        "binary_header": Path(str(base) + ".segy_binary_header.json"),
        "trace_header_summary": Path(str(base) + ".trace_header_summary.json"),
    }


@router.get("/volumes/{volume_id}/info")
async def get_volume_info(volume_id: str):
    volumes = load_volumes()

    if volume_id not in volumes:
        raise HTTPException(status_code=404, detail="Volume not found")

    volume = volumes[volume_id]
    sidecars = _volume_sidecar_paths(volume)

    info = {
        "volume": volume,
        "sidecars": {
            key: {
                "exists": path.exists(),
                "filename": path.name,
            }
            for key, path in sidecars.items()
        },
    }

    viewer_metadata_path = sidecars["viewer_metadata"]
    if viewer_metadata_path.exists():
        with open(viewer_metadata_path, "r") as f:
            info["viewer_metadata"] = json.load(f)
    else:
        info["viewer_metadata"] = None

    binary_header_path = sidecars["binary_header"]
    if binary_header_path.exists():
        with open(binary_header_path, "r") as f:
            info["binary_header"] = json.load(f)
    else:
        info["binary_header"] = None

    trace_summary_path = sidecars["trace_header_summary"]
    if trace_summary_path.exists():
        with open(trace_summary_path, "r") as f:
            info["trace_header_summary"] = json.load(f)
    else:
        info["trace_header_summary"] = None

    text_header_path = sidecars["text_header"]
    if text_header_path.exists():
        info["text_header"] = text_header_path.read_text(encoding="utf-8", errors="replace")
    else:
        info["text_header"] = None

    return info

@router.get("/section2d")
def get_2d_section(
    zarr_path: str = Query(..., description="2D Zarr path, e.g. /data/zarr/<line>.zarr"),
    max_width: int = Query(1600, ge=100, le=4000, description="Maximum rendered trace width for preview."),
    max_height: int = Query(900, ge=100, le=3000, description="Maximum rendered sample/time height for preview."),
    clip_percentile: float = Query(99.0, ge=90.0, le=99.9, description="Absolute amplitude percentile used for display clipping."),
    processing_mode: str = Query("demean", description="2D preview conditioning: raw, demean, trace_rms, agc."),
    sample_interval_sec: float = Query(0.004, gt=0.0, le=0.1, description="Sample interval in seconds after preview decimation. Default assumes 4 ms."),
    agc_window_sec: float = Query(0.5, gt=0.01, le=5.0, description="AGC window length in seconds."),
    filter_type: str = Query("none", description="Frequency filter: none, bandpass, lowpass, highpass."),
    f1: float | None = Query(None, ge=0.0, description="Filter frequency 1 in Hz."),
    f2: float | None = Query(None, ge=0.0, description="Filter frequency 2 in Hz."),
    f3: float | None = Query(None, ge=0.0, description="Filter frequency 3 in Hz."),
    f4: float | None = Query(None, ge=0.0, description="Filter frequency 4 in Hz."),
):
    """
    Return a display-sized 2D seismic section preview from a Zarr array with shape:
      [trace, sample]

    Full-resolution line reads are too slow for survey navigation, especially when
    sent as JSON. This endpoint downsamples to approximately max_width × max_height
    and returns a backend-derived clip amplitude for fast frontend rendering.
    """
    arr_path = _resolve_slice_zarr_path(zarr_path)

    try:
        arr = _slice_zarr.open_array(str(arr_path), mode="r")
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to open Zarr array: {e}")

    source_shape = tuple(arr.shape)

    if len(source_shape) != 2:
        raise HTTPException(status_code=400, detail=f"Expected 2D Zarr array, got shape {source_shape}")

    trace_count, sample_count = source_shape

    trace_stride = max(1, int(_section_np.ceil(trace_count / max_width)))
    sample_stride = max(1, int(_section_np.ceil(sample_count / max_height)))

    try:
        data = arr[::trace_stride, ::sample_stride].astype("float32")
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to read 2D section preview: {e}")

    # Prefer real SEG-Y/Zarr sidecar sample interval metadata.
    # The actual sidecar naming convention is:
    #   <uuid>.zarr.viewer_metadata.json
    # Keep a fallback for older/non-.zarr sidecar names.
    effective_sample_interval_sec = sample_interval_sec
    try:
        candidate_metadata_paths = [
            Path(str(arr_path) + ".viewer_metadata.json"),
        ]

        if arr_path.name.endswith(".zarr"):
            stripped = arr_path.with_name(arr_path.name[:-5])
            candidate_metadata_paths.append(Path(str(stripped) + ".viewer_metadata.json"))

        viewer_metadata = None
        for viewer_metadata_path in candidate_metadata_paths:
            if viewer_metadata_path.exists():
                with open(viewer_metadata_path, "r") as f:
                    viewer_metadata = json.load(f)
                break

        if viewer_metadata:
            sidecar_sample_interval_sec = viewer_metadata.get("sample_interval_sec")
            sidecar_sample_interval_ms = viewer_metadata.get("sample_interval_ms") or viewer_metadata.get("sample_rate")
            sidecar_sample_interval_us = viewer_metadata.get("sample_interval_us")

            # Some older conversion metadata files did not store sample interval in
            # viewer_metadata.json. Fall back to the SEG-Y binary header sidecar.
            if not (sidecar_sample_interval_sec or sidecar_sample_interval_ms or sidecar_sample_interval_us):
                binary_header_path = Path(str(zarr_path) + ".segy_binary_header.json")
                if binary_header_path.exists():
                    try:
                        binary_header = json.loads(binary_header_path.read_text(encoding="utf-8"))
                        sidecar_sample_interval_us = binary_header.get("sample_interval_us")
                    except Exception:
                        sidecar_sample_interval_us = None

            if sidecar_sample_interval_sec:
                effective_sample_interval_sec = float(sidecar_sample_interval_sec)
            elif sidecar_sample_interval_ms:
                effective_sample_interval_sec = float(sidecar_sample_interval_ms) / 1000.0
            elif sidecar_sample_interval_us:
                effective_sample_interval_sec = float(sidecar_sample_interval_us) / 1000000.0
    except Exception:
        effective_sample_interval_sec = sample_interval_sec

    try:
        data, processing_info = process_2d_section(
            data,
            sample_interval_sec=effective_sample_interval_sec * sample_stride,
            processing_mode=processing_mode,
            clip_percentile=clip_percentile,
            agc_window_sec=agc_window_sec,
            filter_type=filter_type,
            f1=f1,
            f2=f2,
            f3=f3,
            f4=f4,
        )
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to process 2D section preview: {e}")

    clip_abs = processing_info.clip_abs
    processing_mode = processing_info.processing_mode

    return {
        "source_shape": list(source_shape),
        "shape": list(data.shape),
        "trace_stride": trace_stride,
        "sample_stride": sample_stride,
        "clip_abs": clip_abs,
        "clip_percentile": clip_percentile,
        "preview": True,
        "processing_mode": processing_mode,
        "processing": processing_info.__dict__,
        "sample_interval_sec": effective_sample_interval_sec,
        "sample_interval_ms": effective_sample_interval_sec * 1000.0,
        "sample_interval_us": int(round(effective_sample_interval_sec * 1000000.0)),
        "data": data.ravel().tolist(),
    }




class Import2DSurveyFolderRequest(BaseModel):
    source_folder: str
    survey_name: str
    replace_existing_survey: bool = False


@router.post("/2d-surveys/import-folder")
async def import_2d_survey_folder(request: Import2DSurveyFolderRequest):
    project_root = Path(__file__).resolve().parents[3]
    import_script = project_root / "import_2d_survey.py"

    source_folder = Path(request.source_folder).expanduser()

    if not import_script.exists():
        return {
            "ok": False,
            "message": f"Import script not found: {import_script}",
        }

    if not source_folder.exists() or not source_folder.is_dir():
        return {
            "ok": False,
            "message": f"Source folder not found: {source_folder}",
        }

    segy_files = []
    for pattern in ("*.sgy", "*.SGY", "*.segy", "*.SEGY"):
        segy_files.extend(source_folder.rglob(pattern))

    if not segy_files:
        return {
            "ok": False,
            "message": f"No SEG-Y files found under: {source_folder}",
        }

    cmd = [
        sys.executable,
        str(import_script),
        "--source-folder",
        str(source_folder),
        "--survey-name",
        request.survey_name,
    ]

    if request.replace_existing_survey:
        cmd.append("--replace-existing-survey")

    try:
        completed = subprocess.run(
            cmd,
            cwd=str(project_root),
            capture_output=True,
            text=True,
            timeout=3600,
        )

        if completed.returncode != 0:
            return {
                "ok": False,
                "message": "2D survey import failed.",
                "returncode": completed.returncode,
                "stdout": completed.stdout[-4000:],
                "stderr": completed.stderr[-4000:],
            }

        return {
            "ok": True,
            "message": f"Imported 2D survey '{request.survey_name}' from {len(segy_files)} SEG-Y files.",
            "source_folder": str(source_folder),
            "survey_name": request.survey_name,
            "file_count": len(segy_files),
            "stdout": completed.stdout[-4000:],
            "stderr": completed.stderr[-4000:],
        }
    except subprocess.TimeoutExpired:
        return {
            "ok": False,
            "message": "2D survey import timed out after 1 hour.",
        }
    except Exception as exc:
        return {
            "ok": False,
            "message": f"2D survey import failed: {exc}",
        }

