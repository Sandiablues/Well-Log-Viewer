from __future__ import annotations

from copy import deepcopy
from typing import Any, Dict, List, Optional


SCHEMA_VERSION = "0.1"


def _as_number(value: Any) -> Optional[float]:
    if value is None:
        return None

    if isinstance(value, bool):
        return None

    if isinstance(value, (int, float)):
        return float(value)

    if isinstance(value, str):
        try:
            return float(value.strip())
        except ValueError:
            return None

    return None


def _as_int(value: Any) -> Optional[int]:
    number = _as_number(value)
    if number is None:
        return None
    return int(number)


def _get_nested(data: Dict[str, Any], *keys: str) -> Any:
    current: Any = data

    for key in keys:
        if not isinstance(current, dict):
            return None
        current = current.get(key)

    return current


def _get_shape(metadata: Dict[str, Any]) -> Optional[List[int]]:
    shape = metadata.get("shape") or _get_nested(metadata, "zarr", "shape")

    if not isinstance(shape, list):
        return None

    clean_shape: List[int] = []

    for item in shape:
        value = _as_int(item)
        if value is None:
            return None
        clean_shape.append(value)

    return clean_shape


def _first_present(metadata: Dict[str, Any], keys: List[str]) -> Any:
    for key in keys:
        if key in metadata and metadata[key] is not None:
            return metadata[key]
    return None


def _range_from_candidates(metadata: Dict[str, Any], keys: List[str]) -> Optional[List[float]]:
    for key in keys:
        value = metadata.get(key)

        if isinstance(value, list) and len(value) >= 2:
            a = _as_number(value[0])
            b = _as_number(value[1])
            if a is not None and b is not None:
                return [a, b]

        if isinstance(value, dict):
            candidates = [
                ("min", "max"),
                ("start", "end"),
                ("first", "last"),
            ]

            for min_key, max_key in candidates:
                a = _as_number(value.get(min_key))
                b = _as_number(value.get(max_key))
                if a is not None and b is not None:
                    return [a, b]

    return None


def _make_axis(
    key: str,
    label: str,
    minimum: Optional[float],
    maximum: Optional[float],
    step: Optional[float],
    unit: str,
    source: str,
    confidence: str,
    extra: Optional[Dict[str, Any]] = None,
) -> Dict[str, Any]:
    axis: Dict[str, Any] = {
        "key": key,
        "label": label,
        "min": minimum,
        "max": maximum,
        "step": step,
        "unit": unit,
        "source": source,
        "confidence": confidence,
    }

    if extra:
        axis.update(extra)

    return axis


def _vertical_axis(metadata: Dict[str, Any], shape: Optional[List[int]]) -> Dict[str, Any]:
    sample_count = (
        _as_int(metadata.get("sample_count"))
        or _as_int(_get_nested(metadata, "zarr", "sample_count"))
    )

    if sample_count is None and shape:
        # Conservative fallback. Many current arrays appear to use the middle axis
        # as samples for 3D and the second axis as samples for 2D.
        if len(shape) == 3:
            sample_count = shape[1]
        elif len(shape) == 2:
            sample_count = shape[1]

    sample_interval_ms = _first_present(
        metadata,
        [
            "sample_interval_ms",
            "sample_rate_ms",
            "dt_ms",
        ],
    )

    sample_interval_us = _first_present(
        metadata,
        [
            "sample_interval_us",
            "sample_rate_us",
            "dt_us",
        ],
    )

    step: Optional[float] = None
    unit = "sample"
    label = "Sample"
    minimum: Optional[float] = 0
    maximum: Optional[float] = float(sample_count - 1) if sample_count else None
    source = "shape"
    confidence = "low"

    ms = _as_number(sample_interval_ms)
    us = _as_number(sample_interval_us)

    if ms is not None and sample_count:
        step = ms
        unit = "ms"
        label = "Two-way time"
        maximum = (sample_count - 1) * ms
        source = "metadata"
        confidence = "medium"
    elif us is not None and sample_count:
        step = us / 1000.0
        unit = "ms"
        label = "Two-way time"
        maximum = (sample_count - 1) * step
        source = "metadata"
        confidence = "medium"

    vertical_domain = metadata.get("vertical_domain")
    vertical_unit = metadata.get("vertical_unit")

    if vertical_domain:
        domain = str(vertical_domain).lower()
        if "depth" in domain:
            label = "Depth"
            unit = str(vertical_unit or "unknown")
        elif "time" in domain or "twt" in domain:
            label = "Two-way time"
            unit = str(vertical_unit or unit)

    return _make_axis(
        key="vertical",
        label=label,
        minimum=minimum,
        maximum=maximum,
        step=step,
        unit=unit,
        source=source,
        confidence=confidence,
        extra={
            "domain": metadata.get("vertical_domain") or ("time" if unit == "ms" else "unknown"),
        },
    )


def _axis_info_for_3d(metadata: Dict[str, Any], shape: Optional[List[int]]) -> Dict[str, Any]:
    axes: List[Dict[str, Any]] = []

    inline_range = _range_from_candidates(
        metadata,
        ["inline_range", "iline_range", "inline", "inlines"],
    )

    crossline_range = _range_from_candidates(
        metadata,
        ["crossline_range", "xline_range", "crossline", "crosslines"],
    )

    if inline_range:
        inline_axis = _make_axis(
            key="inline",
            label="Inline",
            minimum=inline_range[0],
            maximum=inline_range[1],
            step=None,
            unit="number",
            source="metadata",
            confidence="medium",
        )
    else:
        count = shape[0] if shape and len(shape) >= 1 else None
        inline_axis = _make_axis(
            key="inline",
            label="Inline index",
            minimum=0,
            maximum=float(count - 1) if count else None,
            step=1,
            unit="index",
            source="shape",
            confidence="low",
        )

    if crossline_range:
        crossline_axis = _make_axis(
            key="crossline",
            label="Crossline",
            minimum=crossline_range[0],
            maximum=crossline_range[1],
            step=None,
            unit="number",
            source="metadata",
            confidence="medium",
        )
    else:
        count = shape[2] if shape and len(shape) >= 3 else None
        crossline_axis = _make_axis(
            key="crossline",
            label="Crossline index",
            minimum=0,
            maximum=float(count - 1) if count else None,
            step=1,
            unit="index",
            source="shape",
            confidence="low",
        )

    axes.append(inline_axis)
    axes.append(crossline_axis)
    axes.append(_vertical_axis(metadata, shape))

    return {
        "axes": axes,
    }


def _axis_info_for_2d(metadata: Dict[str, Any], shape: Optional[List[int]]) -> Dict[str, Any]:
    axes: List[Dict[str, Any]] = []

    shotpoint_range = _range_from_candidates(
        metadata,
        ["shotpoint_range", "sp_range", "shotpoints"],
    )

    cdp_range = _range_from_candidates(
        metadata,
        ["cdp_range", "cdps"],
    )

    trace_count = (
        _as_int(metadata.get("trace_count"))
        or (shape[0] if shape and len(shape) >= 1 else None)
    )

    if shotpoint_range:
        horizontal = _make_axis(
            key="horizontal",
            label="Shotpoint",
            minimum=shotpoint_range[0],
            maximum=shotpoint_range[1],
            step=None,
            unit="number",
            source="metadata",
            confidence="medium",
        )
    elif cdp_range:
        horizontal = _make_axis(
            key="horizontal",
            label="CDP",
            minimum=cdp_range[0],
            maximum=cdp_range[1],
            step=None,
            unit="number",
            source="metadata",
            confidence="medium",
        )
    else:
        horizontal = _make_axis(
            key="horizontal",
            label="Trace index",
            minimum=0,
            maximum=float(trace_count - 1) if trace_count else None,
            step=1,
            unit="index",
            source="shape",
            confidence="low",
        )

    axes.append(horizontal)
    axes.append(_vertical_axis(metadata, shape))

    return {
        "axes": axes,
    }


def _extent_info(metadata: Dict[str, Any]) -> Dict[str, Any]:
    existing = (
        metadata.get("extent_info")
        or metadata.get("survey_extent")
        or metadata.get("line_extent")
        or metadata.get("coordinate_extent")
        or {}
    )

    extent: Dict[str, Any] = {
        "has_coordinates": False,
        "crs": metadata.get("crs") or metadata.get("epsg") or None,
        "source": "none",
        "confidence": "low",
    }

    if isinstance(existing, dict):
        extent.update(deepcopy(existing))

    x_min = _as_number(
        extent.get("x_min")
        or metadata.get("x_min")
        or metadata.get("min_x")
    )
    x_max = _as_number(
        extent.get("x_max")
        or metadata.get("x_max")
        or metadata.get("max_x")
    )
    y_min = _as_number(
        extent.get("y_min")
        or metadata.get("y_min")
        or metadata.get("min_y")
    )
    y_max = _as_number(
        extent.get("y_max")
        or metadata.get("y_max")
        or metadata.get("max_y")
    )

    if None not in (x_min, x_max, y_min, y_max):
        extent.update(
            {
                "has_coordinates": True,
                "x_min": x_min,
                "x_max": x_max,
                "y_min": y_min,
                "y_max": y_max,
                "source": "metadata",
                "confidence": "medium",
            }
        )

    return extent


def _segy_info(metadata: Dict[str, Any]) -> Dict[str, Any]:
    segy: Dict[str, Any] = {}

    for key in [
        "textual_header",
        "ebcdic_header",
        "binary_header",
        "binary_header_summary",
        "trace_header_summary",
        "trace_header_stats",
    ]:
        if key in metadata:
            segy[key] = metadata[key]

    return segy


def _qc_info(dataset: Dict[str, Any], metadata: Dict[str, Any], axis_info: Dict[str, Any], extent_info: Dict[str, Any]) -> Dict[str, Any]:
    warnings: List[str] = []

    dataset_type = dataset.get("dataset_type") or "unknown"
    shape = _get_shape(metadata)

    if not shape:
        warnings.append("Array shape unavailable")

    if dataset_type == "3d_volume":
        axis_keys = {axis.get("key") for axis in axis_info.get("axes", [])}
        if "inline" not in axis_keys:
            warnings.append("Inline axis unavailable")
        if "crossline" not in axis_keys:
            warnings.append("Crossline axis unavailable")

    if not extent_info.get("has_coordinates"):
        warnings.append("Coordinate extent unavailable")

    if not extent_info.get("crs"):
        warnings.append("CRS unavailable")

    vertical = next(
        (axis for axis in axis_info.get("axes", []) if axis.get("key") == "vertical"),
        None,
    )

    if vertical and vertical.get("confidence") == "low":
        warnings.append("Vertical axis uses sample index fallback")

    return {
        "warnings": warnings,
    }


def normalize_dataset_metadata(dataset: Dict[str, Any]) -> Dict[str, Any]:
    """
    Return a copy of the dataset with metadata.normalized populated.

    This is additive. It preserves existing metadata and raw extracted fields.
    """
    result = deepcopy(dataset)

    metadata: Dict[str, Any] = result.setdefault("metadata", {})
    if not isinstance(metadata, dict):
        metadata = {}
        result["metadata"] = metadata

    dataset_type = result.get("dataset_type") or metadata.get("dataset_type") or "unknown"
    shape = _get_shape(metadata)

    if dataset_type == "3d_volume" or (shape and len(shape) == 3):
        dataset_kind = "3d_volume"
        axis_info = _axis_info_for_3d(metadata, shape)
    elif dataset_type in {"2d_line", "2d_survey"} or (shape and len(shape) == 2):
        dataset_kind = dataset_type if dataset_type in {"2d_line", "2d_survey"} else "2d_line"
        axis_info = _axis_info_for_2d(metadata, shape)
    else:
        dataset_kind = dataset_type or "unknown"
        axis_info = {"axes": []}

    extent_info = _extent_info(metadata)
    segy_info = _segy_info(metadata)
    qc_info = _qc_info(result, metadata, axis_info, extent_info)

    existing_normalized = metadata.get("normalized")
    custom = {}

    if isinstance(existing_normalized, dict):
        custom = deepcopy(existing_normalized.get("custom") or {})

    metadata["normalized"] = {
        "schema_version": SCHEMA_VERSION,
        "dataset_kind": dataset_kind,
        "axis_info": axis_info,
        "extent_info": extent_info,
        "qc_info": qc_info,
        "segy_info": segy_info,
        "viewer_info": {
            "axis_labels_available": bool(axis_info.get("axes")),
            "coordinate_display_available": bool(extent_info.get("has_coordinates")),
        },
        "custom": custom,
    }

    return result


def normalize_volumes_payload(payload: Any) -> Any:
    """
    Normalize a volumes.json payload while preserving its storage shape.

    Supported shapes:
    1. [dataset, dataset, ...]
    2. {"volumes": [dataset, ...]}
    3. {"datasets": [dataset, ...]}
    4. {"dataset_id": dataset, "dataset_id": dataset, ...}
    """
    if isinstance(payload, list):
        return [
            normalize_dataset_metadata(item) if isinstance(item, dict) else item
            for item in payload
        ]

    if isinstance(payload, dict):
        result = deepcopy(payload)

        # Wrapper form: {"volumes": [...]} or {"datasets": [...]}
        for key in ["volumes", "datasets"]:
            value = result.get(key)
            if isinstance(value, list):
                result[key] = [
                    normalize_dataset_metadata(item) if isinstance(item, dict) else item
                    for item in value
                ]
                return result

        # Registry-map form used by this app:
        # {"uuid": {"id": "uuid", "metadata": ...}, ...}
        looks_like_registry_map = all(
            isinstance(value, dict) and (
                "metadata" in value
                or "dataset_type" in value
                or "zarr_url" in value
                or "filename" in value
            )
            for value in result.values()
        )

        if looks_like_registry_map:
            return {
                key: normalize_dataset_metadata(value) if isinstance(value, dict) else value
                for key, value in result.items()
            }

        return result

    return payload
