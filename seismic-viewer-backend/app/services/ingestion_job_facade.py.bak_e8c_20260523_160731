from __future__ import annotations

import json
import os
import shutil
import uuid
from pathlib import Path
from typing import Any, Dict

from fastapi import HTTPException, UploadFile

from app.api import endpoints as legacy_endpoints


def _jobs_dir() -> Path:
    return Path(getattr(legacy_endpoints, "JOBS_DIR", "./data/jobs"))


async def upload_segy(file: UploadFile) -> Dict[str, Any]:
    """
    Accept a SEG-Y upload and queue conversion using the existing conversion
    engine.

    This moves ingestion/job orchestration out of the general endpoints module
    without changing the conversion service or job file format.
    """
    file_id = str(uuid.uuid4())
    job_id = str(uuid.uuid4())

    upload_dir = getattr(legacy_endpoints, "UPLOAD_DIR", "./data/uploads")
    zarr_dir = getattr(legacy_endpoints, "ZARR_DIR", "./data/zarr")
    zarr_tmp_dir = getattr(legacy_endpoints, "ZARR_TMP_DIR", "./data/zarr_tmp")
    jobs_dir = getattr(legacy_endpoints, "JOBS_DIR", "./data/jobs")

    os.makedirs(upload_dir, exist_ok=True)
    os.makedirs(zarr_dir, exist_ok=True)
    os.makedirs(zarr_tmp_dir, exist_ok=True)
    os.makedirs(jobs_dir, exist_ok=True)

    file_path = os.path.join(upload_dir, f"{file_id}.sgy")
    output_path = os.path.join(zarr_dir, f"{file_id}.zarr")
    temp_output_path = os.path.join(zarr_tmp_dir, f"{file_id}.zarr.tmp")

    with open(file_path, "wb") as buffer:
        shutil.copyfileobj(file.file, buffer)

    legacy_endpoints.job_service.create_job(
        job_id=job_id,
        file_id=file_id,
        filename=file.filename,
        input_path=file_path,
        output_path=output_path,
        temp_output_path=temp_output_path,
    )

    legacy_endpoints.conversion_executor.submit(
        legacy_endpoints.conversion_job_service.run,
        job_id,
    )

    return {
        "job_id": job_id,
        "file_id": file_id,
        "status": "queued",
        "message": "SEG-Y upload accepted. Conversion started.",
    }


def list_recent_jobs(limit: int = 20) -> Dict[str, Any]:
    """
    List recent conversion jobs.
    """
    jobs_path = _jobs_dir()
    jobs_path.mkdir(parents=True, exist_ok=True)

    jobs = []
    for path in jobs_path.glob("*.json"):
        try:
            with open(path, "r") as f:
                job = json.load(f)
            job.setdefault("job_id", path.stem)
            job["_modified_time"] = path.stat().st_mtime
            jobs.append(job)
        except Exception:
            continue

    jobs.sort(key=lambda job: job.get("_modified_time", 0), reverse=True)

    for job in jobs:
        job.pop("_modified_time", None)

    return {
        "count": len(jobs),
        "jobs": jobs[:limit],
    }


def get_conversion_job(job_id: str) -> Dict[str, Any]:
    """
    Read a single conversion job using the existing job service.
    """
    job = legacy_endpoints.job_service.get_job(job_id)
    if not job:
        raise HTTPException(status_code=404, detail=f"Job not found: {job_id}")
    return job
